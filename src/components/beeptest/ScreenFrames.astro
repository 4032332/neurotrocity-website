---
import { BEEPTEST } from '../../content/beeptest';

const { frames } = BEEPTEST;
// The App Store screenshots as submitted; each image carries its own headline.
---
<section class="bt-sec" aria-labelledby="bt-frames-h">
  <div class="bt-wrap">
    <p class="bt-mono bt-eyebrow">{frames.eyebrow}</p>
    <h2 class="bt-h2" id="bt-frames-h">{frames.heading}</h2>
    <div class="bt-frames">
      {frames.shots.map((shot) => (
        <figure class="bt-frame">
          <img src={`/beeptest/assets/img/screens/${shot.file}`} alt={shot.alt}
               width="645" height="1398" loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  </div>
</section>
