---
---
<svg id="spine" aria-hidden="true">
  <defs>
    <linearGradient id="gSpine" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%"   stop-color="#7C6BFF"/>
      <stop offset="55%"  stop-color="#38E1D6"/>
      <stop offset="100%" stop-color="#FF8A4C"/>
    </linearGradient>
    <filter id="fGlow" x="-160%" y="-160%" width="420%" height="420%">
      <feGaussianBlur stdDeviation="4" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <path id="spineBase" fill="none" stroke="#241F3D" stroke-width="1.5"/>
  <path id="spineLit"  fill="none" stroke="url(#gSpine)" stroke-width="1.8"
        filter="url(#fGlow)" stroke-linecap="round"/>
  <g id="somata"></g>
  <g id="sparks"></g>
</svg>
<script>
  import { mountSpine } from '../motion/spine';

  const svg = document.getElementById('spine') as unknown as SVGSVGElement;
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-soma]'));
  // Below 1000px the SVG is display:none (see <style>): no rAF should run there.
  const wide = matchMedia('(min-width: 1000px)');
  let handle: ReturnType<typeof mountSpine> | null = null;
  const sync = () => {
    if (wide.matches && !handle) handle = mountSpine(svg, sections);
    else if (!wide.matches && handle) { handle.destroy(); handle = null; }
  };
  wide.addEventListener('change', sync);
  sync();
</script>
<style>
  #spine {
    position: fixed; top: 0; left: 0; height: 100vh; width: var(--gutter);
    z-index: 1; pointer-events: none; overflow: visible;
  }
  /* complement of the (min-width: 1000px) gate in the script above */
  @media (max-width: 999.98px) { #spine { display: none; } }
</style>
