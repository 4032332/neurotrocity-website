---
/**
 * One venture as a row of evidence: slug path, live-site description
 * verbatim, platforms, and an arrow. Accent colour arrives as `--c`.
 */
import type { Product } from '../content/facts';

interface Props { product: Product }
const { product } = Astro.props;
---
<a class="vrow" href={product.path} style={`--c:var(--${product.accent})`}>
  <span class="sl">/{product.slug}</span>
  <span class="ds">{product.description}</span>
  <span class="mt">{product.platforms}</span>
  <span class="go" aria-hidden="true">→</span>
</a>

<style>
  .vrow{
    display:grid; grid-template-columns:minmax(110px,auto) 1fr auto auto; gap:22px;
    align-items:baseline; padding:22px 0; border-bottom:1px solid var(--line);
    text-decoration:none; color:inherit; transition:background .18s;
  }
  .vrow:first-child{ border-top:1px solid var(--line) }
  .vrow:hover{ background:var(--ground-2) }
  .sl{ font-family:var(--mono); font-size:13.5px; color:var(--c,var(--volt)) }
  .ds{ color:var(--muted); font-size:15px; line-height:1.5 }
  .vrow:hover .ds{ color:var(--ink) }
  .mt{ font-family:var(--mono); font-size:10.5px; color:var(--muted); letter-spacing:.09em; white-space:nowrap }
  .go{ font-family:var(--mono); font-size:15px; color:var(--c,var(--volt)); opacity:.35; transition:opacity .18s, transform .18s }
  .vrow:hover .go, .vrow:focus-visible .go{ opacity:1; transform:translateX(3px) }
  @media (max-width:820px){
    .vrow{ grid-template-columns:1fr auto; gap:6px 14px }
    .sl{ grid-column:1 }
    .go{ grid-column:2; grid-row:1 }
    .ds,.mt{ grid-column:1/-1 }
  }
</style>
