---
interface Props { accent?: 'volt' | 'jade' }
const { accent = 'volt' } = Astro.props;
---
<canvas id="field" aria-hidden="true" data-accent={accent}></canvas>
<script>
  import { detectTier } from '../motion/tier';
  import type { Accent } from '../motion/cortex/palette';

  const canvas = document.getElementById('field') as HTMLCanvasElement;

  async function boot() {
    // Probe capability on a scratch canvas: a context created on #field here
    // would pin its attributes, and three.js's preserveDrawingBuffer would be
    // silently ignored.
    const gl = document.createElement('canvas').getContext('webgl2');
    const tier = detectTier({
      hasWebgl2: !!gl,
      deviceMemory: (navigator as any).deviceMemory,
      hardwareConcurrency: navigator.hardwareConcurrency,
      reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches,
      maxTextureSize: gl ? gl.getParameter(gl.MAX_TEXTURE_SIZE) : 0,
    });
    gl?.getExtension('WEBGL_lose_context')?.loseContext();
    if (tier === 'none') {
      canvas.classList.add('static-fallback');
      return;
    }
    // Dynamic import: three.js (and the rest of the cortex module graph)
    // must not compete with fonts/CSS for bandwidth during the LCP window.
    const { mountCortex } = await import('../motion/cortex');
    mountCortex(canvas, { tier, accent: canvas.dataset.accent as Accent });
  }

  // Mount after the page has painted its LCP content, so the field's own
  // bundle (three.js) never competes with it. A brief static ground colour
  // shows first; the field itself is unchanged once mounted.
  function schedule() {
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(boot, { timeout: 500 });
    else setTimeout(boot, 1);
  }
  if (document.readyState === 'complete') schedule();
  else window.addEventListener('load', schedule, { once: true });
</script>
<style>
  #field {
    position: fixed; inset: 0; width: 100%; height: 100%;
    z-index: 0; display: block; pointer-events: none;
  }
  #field.static-fallback {
    background: radial-gradient(72% 88% at 66% 30%, #1C1740, #07060E 72%);
  }
</style>
