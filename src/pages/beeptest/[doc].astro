---
// /beeptest/privacy/, /beeptest/eula/ and /beeptest/support/.
// Text lives in src/content/beeptest-docs.ts (reached through BEEPTEST.docs so
// the s5M(8) unit test scans it). /beeptest/terms/ redirects to /eula/
// (astro.config.mjs). All three are indexed and listed in sitemap.xml.ts.
import BeeptestLayout from '../../components/beeptest/BeeptestLayout.astro';
import { BEEPTEST } from '../../content/beeptest';

type Doc = keyof typeof BEEPTEST.docs.pages;

export function getStaticPaths() {
  return (Object.keys(BEEPTEST.docs.pages) as Doc[]).map((doc) => ({ params: { doc } }));
}

const doc = Astro.params.doc as Doc;
const meta = BEEPTEST.docs.pages[doc];
const { docs } = BEEPTEST;
---
<BeeptestLayout title={meta.title} description={meta.description} path={`/beeptest/${doc}/`}>
  <article class="bt-doc">
    <div class="bt-wrap">
      <h1 class="bt-h2">{meta.heading}</h1>
      <p class="bt-body bt-updated">{BEEPTEST.name} · {docs.updated}</p>
      {meta.sections.map((s) => (
        <section>
          <h2 class="bt-doc-h">{s.h}</h2>
          {s.body.map((b) =>
            typeof b === 'string'
              ? <p class="bt-body" set:html={b} />
              : <ul class="bt-body">{b.map((li) => <li set:html={li} />)}</ul>
          )}
        </section>
      ))}
    </div>
  </article>
</BeeptestLayout>
