---
import Base from '../layouts/Base.astro';
import ChalkOutline from '../components/ChalkOutline.astro';
import { PRODUCTS_PAGE } from '../content/copy';
import { isLive } from '../content/facts';

const { meta, nav, hero, books, contact, footer } = PRODUCTS_PAGE;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: meta.title,
  description: meta.description,
  url: meta.canonical,
  isPartOf: { '@type': 'WebSite', name: 'NeuroTrocity', url: 'https://neurotrocity.com/' },
  mainEntity: {
    '@type': 'ItemList',
    // Live books only: a coming-soon book is not on offer.
    itemListElement: books.items.filter(isLive).map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: { '@type': 'Book', name: b.title, url: b.url, author: { '@type': 'Organization', name: 'NeuroTrocity' } },
    })),
  },
};
---
<Base title={meta.title} description={meta.description} path="/products/" ogImage="/og/products.png" jsonLd={jsonLd} accent="flare" field spine>

<Fragment slot="head">
<style is:global>
/* ── frame ─────────────────────────────────────────────────────────────── */
a{ text-decoration:none }
.wrap{ max-width:var(--maxw); margin:0 auto; padding-inline:var(--pad) }
@media (min-width:1001px){ .wrap{ padding-left:calc(var(--gutter) + 16px) } }
.mono{ font-family:var(--mono); font-size:11px; letter-spacing:.16em; text-transform:uppercase; font-variant-numeric:tabular-nums }
strong{ color:var(--ink); font-weight:700 }

/* ── nav bar (Base renders the <header>; this styles it) ───────────────── */
body > header:has(.bar){
  position:sticky; top:0; z-index:10;
  background:color-mix(in srgb, var(--ground) 62%, transparent);
  backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  border-bottom:1px solid transparent;
}
@supports (animation-timeline: scroll()){
  body > header:has(.bar){ animation:bar-on linear both; animation-timeline:scroll(root); animation-range:0 40px }
  @keyframes bar-on{ from{ border-bottom-color:transparent } to{ border-bottom-color:var(--line) } }
}
.bar .wrap{ display:flex; align-items:center; gap:18px; height:66px }
.mk{ display:inline-flex; align-items:center; gap:9px; font-weight:800; font-size:18px; letter-spacing:-.03em; color:var(--ink) }
.mk i{ width:9px; height:9px; border-radius:50%; background:var(--flare); box-shadow:0 0 12px var(--flare); display:block; flex:none }
.mk .t{ color:var(--flare) }
.grow{ flex:1 }
.nav{ display:flex; gap:22px; font-size:14px; color:var(--muted) }
.nav a{ transition:color .18s }
.nav a:hover{ color:var(--ink) }
@media (max-width:820px){ .nav{ display:none } }
.navcta{
  font-size:13.5px; font-weight:800; padding:9px 16px; border-radius:999px; color:var(--ink); white-space:nowrap;
  border:1px solid color-mix(in srgb, var(--flare) 45%, transparent);
  background:color-mix(in srgb, var(--flare) 12%, transparent);
  transition:background .18s, border-color .18s;
}
.navcta:hover{ background:color-mix(in srgb, var(--flare) 26%, transparent); border-color:var(--flare) }
@media (max-width:420px){ .bar .wrap{ gap:12px } }

/* ── hero ──────────────────────────────────────────────────────────────── */
.hero{ min-height:min(72vh,640px); display:flex; align-items:center; padding-block:70px }
/* .wrap is a flex item here, so it sizes to its content rather than honouring
   max-width, and margin:0 auto then centres the shrunken box — which put the
   banner 228px to the right of every section below it. Fill the line instead. */
.hero .wrap{ width:100% }
.hero .copy{ max-width:100% }
.hero .kick{ color:var(--flare); margin-bottom:20px }
.hero h1{ font-weight:800; font-size:var(--step-3); line-height:.99; letter-spacing:-.036em; max-width:15ch; text-wrap:balance }
.hero h1 em{ font-style:normal; color:var(--flare) }
.hero .sub{
  margin-top:18px; max-width:46ch; color:var(--ink); font-weight:500;
  font-size:clamp(17px,1.9vw,21px); line-height:1.4; letter-spacing:-.012em;
  text-wrap:balance;
}
.hero .lede{ margin-top:18px; max-width:64ch; color:var(--muted); font-size:clamp(15.5px,1.5vw,17.5px); line-height:1.64 }
.cta{ margin-top:32px; display:flex; gap:11px; flex-wrap:wrap }
.btn{
  display:inline-flex; align-items:center; gap:9px; font-size:14.5px; font-weight:800;
  padding:13px 21px; border-radius:6px; border:1px solid transparent; font-family:var(--body);
  transition:transform .18s, background .18s, border-color .18s, color .18s;
}
.btn .arw{ transition:transform .25s }
.btn:hover .arw{ transform:translateX(4px) }
/* Flare is too light for white text at this size (≈3.5:1): dark ink instead. */
.btn.p{ background:var(--flare); color:#07060E }
.btn.p:hover{ background:color-mix(in srgb, var(--flare) 88%, white); transform:translateY(-2px) }
.btn.g{ border-color:var(--line-2); color:var(--ink) }
.btn.g:hover{ border-color:var(--flare); color:var(--flare); transform:translateY(-2px) }

/* ── sections ──────────────────────────────────────────────────────────── */
section.sec{ padding-block:clamp(64px,8vw,104px); position:relative }
.eyebrow{ color:var(--muted); margin-bottom:16px }
h2{ font-weight:800; font-size:var(--step-2); line-height:1.03; letter-spacing:-.034em; max-width:21ch; text-wrap:balance }
.sub{ margin-top:16px; color:var(--muted); font-size:16.5px; line-height:1.65; max-width:56ch }

/* ── #books: a range pane, then one 3:4 tile per book ─────────────────── */
.range{ margin-top:0 }
.range .note{ margin-top:14px; color:var(--muted); font-size:15.5px; line-height:1.62; max-width:56ch }
.books{ margin-top:22px; display:grid; gap:18px; grid-template-columns:repeat(3,1fr) }
@media (max-width:900px){ .books{ grid-template-columns:repeat(2,1fr) } }
@media (max-width:520px){ .books{ grid-template-columns:1fr } }
.book{
  display:flex; flex-direction:column; overflow:hidden; color:inherit;
  border:1px solid var(--line); border-radius:8px;
  background:color-mix(in srgb, var(--ground-2) 80%, transparent);
  transition:border-color .25s, background .25s, transform .25s;
}
.book .art{ display:block; position:relative; aspect-ratio:3/4; overflow:hidden; border-bottom:1px solid var(--line) }
.book .art img{ width:100%; height:100%; display:block; object-fit:cover; transition:transform .5s cubic-bezier(.22,1,.36,1) }
.book .body{ display:flex; flex-direction:column; flex:1; padding:18px 20px 22px }
.book h3{ font-weight:800; letter-spacing:-.03em; font-size:clamp(20px,2vw,24px); color:var(--ink) }
.book p{ margin-top:8px; color:var(--muted); font-size:14.5px; line-height:1.55 }
.book .go{ margin-top:auto; padding-top:16px; font-family:var(--mono); font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:var(--flare) }
.book .go .arw{ display:inline-block; transition:transform .25s }
a.book:hover, a.book:focus-visible{
  border-color:color-mix(in srgb, var(--flare) 58%, transparent);
  background:color-mix(in srgb, var(--flare) 7%, var(--ground-2));
  transform:translateY(-3px);
}
a.book:hover .art img, a.book:focus-visible .art img{ transform:scale(1.03) }
a.book:hover .go .arw, a.book:focus-visible .go .arw{ transform:translateX(4px) }

/* Coming soon: a chalk outline on the dark, the title on a white cover
   panel, and a strip of hazard tape. Not a link. */
.book.soon .art{ background:var(--ground-2); color:#E9E6F2; display:grid; place-items:end center }
.book.soon .chalk{ width:58%; height:auto; opacity:.9; margin-bottom:4% }
.book.soon .panel{
  position:absolute; left:10%; right:10%; top:9%; padding:8px 6px;
  background:#fff; color:#000; text-align:center;
  font-family:var(--display); font-weight:800; font-size:clamp(14px,1.5vw,17px); letter-spacing:-.01em; line-height:1.05;
}
.book.soon .tape{
  position:absolute; left:-20%; right:-20%; bottom:22%; transform:rotate(-12deg);
  background:#FFC93C; color:#07060E; padding:6px 0; text-align:center; white-space:nowrap;
  font-family:var(--mono); font-size:11px; font-weight:600; letter-spacing:.18em; text-transform:uppercase;
  box-shadow:0 2px 0 rgba(0,0,0,.35);
}
.book.soon .go{ color:var(--muted) }

@media (prefers-reduced-motion:reduce){
  .book, .book .art img, .book .go .arw{ transition:none }
  a.book:hover, a.book:focus-visible{ transform:none }
  a.book:hover .art img, a.book:focus-visible .art img{ transform:none }
}

/* ── #contact ──────────────────────────────────────────────────────────── */
.contact{ text-align:center }
.contact .copy{ max-width:56ch; margin-inline:auto }
.contact h2, .contact .sub{ margin-inline:auto }
.say{
  display:inline-block; margin-top:28px; font-family:var(--display); font-size:clamp(21px,3.3vw,33px);
  font-weight:800; letter-spacing:-.03em; color:var(--flare); overflow-wrap:anywhere;
  border-bottom:2px solid transparent; transition:border-color .2s;
}
.say:hover{ border-bottom-color:var(--flare) }

/* ── footer ────────────────────────────────────────────────────────────── */
footer{ padding:44px 0 52px; color:var(--muted); font-size:13px }
.foot-pane{ padding:clamp(24px,2.6vw,32px); opacity:.94 }
.foot{ display:flex; justify-content:space-between; gap:28px 48px; flex-wrap:wrap; align-items:flex-start }
.foot .lead{ max-width:280px }
.foot .lead .mk{ margin-bottom:12px; font-size:16px }
.foot .lead p{ line-height:1.58 }
.foot .cols{ display:flex; gap:12px 28px; flex-wrap:wrap; font-family:var(--mono); font-size:12px; letter-spacing:.04em }
.foot .cols a{ color:var(--muted); transition:color .18s }
.foot .cols a:hover{ color:var(--flare) }
.foot-base{ margin-top:30px; padding-top:0; font-family:var(--mono); font-size:11.5px; font-variant-numeric:tabular-nums }
</style>
</Fragment>

<Fragment slot="nav">
<div class="bar">
  <div class="wrap">
    <a class="mk" href="/" aria-label="NeuroTrocity home"><i aria-hidden="true"></i><b>Neuro<span class="t">Trocity</span></b></a>
    <span class="grow"></span>
    <nav class="nav" aria-label="Primary">
      <a href={nav.back.href}>{nav.back.label}</a>
      {nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="navcta" href={nav.cta.href}>{nav.cta.label}</a>
  </div>
</div>
</Fragment>

<!-- hero -->
<div class="hero" id="s-hero" data-hero data-soma="Hero">
  <div class="wrap">
    <div class="copy pane">
      <p class="mono kick">{hero.kicker}</p>
      <h1>{hero.headline.lead}<em>{hero.headline.em}</em></h1>
      <p class="sub">{hero.sub}</p>
      <p class="lede">{hero.lede.a}<strong>{hero.lede.strong}</strong>{hero.lede.b}</p>
      <div class="cta">
        <a class="btn p" href={hero.primary.href} target="_blank" rel="noopener">{hero.primary.label} <span class="arw" aria-hidden="true">↗</span></a>
        <a class="btn g" href={hero.ghost.href}>{hero.ghost.label}</a>
      </div>
    </div>
  </div>
</div>

<section class="sec" id="books" data-soma="Colouring books">
  <div class="wrap">
    <div class="range pane">
      <p class="mono eyebrow">{books.eyebrow}</p>
      <h2>{books.heading}</h2>
      <p class="note">{books.note}</p>
    </div>
    <div class="books">
      {books.items.map((b) => isLive(b) ? (
        <a class="book live" href={b.url} target="_blank" rel="noopener">
          <span class="art">
            <img src={b.cover} alt={b.coverAlt} width="600" height="782" loading="lazy" decoding="async" />
          </span>
          <span class="body">
            <h3>{b.title}</h3>
            <p>{b.hook}</p>
            <span class="go">{books.buy} <span class="arw" aria-hidden="true">↗</span></span>
          </span>
        </a>
      ) : (
        <div class="book soon">
          <span class="art">
            <ChalkOutline prop={b.prop} />
            <span class="panel" aria-hidden="true">{b.title}</span>
            <span class="tape" aria-hidden="true">{books.soon} · {books.soon} · {books.soon}</span>
          </span>
          <span class="body">
            <h3>{b.title}</h3>
            <p>{b.hook}</p>
            <span class="go">{books.soon}</span>
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="sec contact" id="contact" data-soma="Contact">
  <div class="wrap">
    <div class="copy pane">
      <p class="mono eyebrow">{contact.eyebrow}</p>
      <h2>{contact.heading}</h2>
      <p class="sub">{contact.sub}</p>
      <a class="say" href={`mailto:${contact.email}`}>{contact.email}</a>
    </div>
  </div>
</section>

<Fragment slot="footer">
<footer>
  <div class="wrap">
    <div class="pane foot-pane">
    <div class="foot">
      <div class="lead">
        <a class="mk" href="/" aria-label="NeuroTrocity home"><i aria-hidden="true"></i><b>Neuro<span class="t">Trocity</span></b></a>
        <p>{footer.tagline}</p>
      </div>
      <nav class="cols" aria-label="Footer">
        {footer.links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href={`mailto:${footer.email}`}>{footer.email}</a>
      </nav>
    </div>
    <div class="foot-base">{footer.legal}</div>
    </div>
  </div>
</footer>
</Fragment>

</Base>
