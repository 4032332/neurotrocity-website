---
import Base from '../../layouts/Base.astro';
import DemoDeck from '../../components/DemoDeck.astro';
import { REWIRE_PAGE } from '../../content/copy';

const { meta, nav, hero, fits, how, demos, review, footer } = REWIRE_PAGE;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Rewire',
  serviceType: 'Website design and rebuild',
  provider: { '@type': 'Organization', name: 'NeuroTrocity', url: 'https://neurotrocity.com/' },
  areaServed: { '@type': 'Country', name: 'Australia' },
  url: 'https://neurotrocity.com/rewire/landing/',
};
---
<Base title={meta.title} description={meta.description} path="/rewire/landing/" ogImage="/og/rewire.png" jsonLd={jsonLd} accent="jade" field spine>

<Fragment slot="head">
<style is:global>
/* ── frame ─────────────────────────────────────────────────────────────── */
a{ text-decoration:none }
.wrap{ max-width:var(--maxw); margin:0 auto; padding-inline:var(--pad) }
@media (min-width:1001px){ .wrap{ padding-left:calc(var(--gutter) + 16px) } }
.mono{ font-family:var(--mono); font-size:11px; letter-spacing:.16em; text-transform:uppercase; font-variant-numeric:tabular-nums }
strong{ color:var(--ink); font-weight:700 }

/* ── nav bar ───────────────────────────────────────────────────────────── */
body > header:has(.bar){
  position:sticky; top:0; z-index:10;
  background:color-mix(in srgb, var(--ground) 62%, transparent);
  backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  border-bottom:1px solid transparent;
}
@supports (animation-timeline: scroll()){
  body > header:has(.bar){ animation:bar-on linear both; animation-timeline:scroll(root); animation-range:0 40px }
  @keyframes bar-on{ from{ border-bottom-color:transparent } to{ border-bottom-color:var(--line) } }
}
.bar .wrap{ display:flex; align-items:center; gap:18px; height:66px }
.mk{ display:inline-flex; align-items:center; gap:9px; font-weight:800; font-size:18px; letter-spacing:-.03em; color:var(--ink) }
.mk i{ width:9px; height:9px; border-radius:50%; background:var(--jade); box-shadow:0 0 12px var(--jade); display:block; flex:none }
.mk .t{ color:var(--jade) }
.grow{ flex:1 }
.back{ font-size:14px; color:var(--muted); transition:color .18s; white-space:nowrap }
.back:hover{ color:var(--ink) }
.navcta{
  font-size:13.5px; font-weight:800; padding:9px 16px; border-radius:999px; color:var(--ink); white-space:nowrap;
  border:1px solid color-mix(in srgb, var(--jade) 45%, transparent);
  background:color-mix(in srgb, var(--jade) 12%, transparent);
  transition:background .18s, border-color .18s;
}
.navcta:hover{ background:color-mix(in srgb, var(--jade) 26%, transparent); border-color:var(--jade) }
@media (max-width:420px){ .bar .wrap{ gap:12px } .back{ font-size:13px } }

/* ── hero ──────────────────────────────────────────────────────────────── */
.hero{ min-height:min(88vh,760px); display:flex; align-items:center; padding-block:70px }
.hero .copy{ width:fit-content; max-width:100% }
.hero .kick{ color:var(--jade); margin-bottom:20px }
.hero h1{ font-weight:800; font-size:var(--step-3); line-height:.99; letter-spacing:-.036em; max-width:15ch; text-wrap:balance }
.hero h1 em{ font-style:normal; color:var(--jade) }
.hero .lede{ margin-top:24px; max-width:47ch; color:var(--muted); font-size:clamp(15.5px,1.5vw,17.5px); line-height:1.64 }
.cta{ margin-top:32px; display:flex; gap:11px; flex-wrap:wrap }
.btn{
  display:inline-flex; align-items:center; gap:9px; font-size:14.5px; font-weight:800;
  padding:13px 21px; border-radius:6px; border:1px solid transparent; font-family:var(--body);
  transition:transform .18s, background .18s, border-color .18s, color .18s;
}
.btn .arw{ transition:transform .25s }
.btn:hover .arw{ transform:translateX(4px) }
.btn.p{ background:var(--jade); color:var(--ground) }
.btn.p:hover{ background:color-mix(in srgb, var(--jade) 86%, white); transform:translateY(-2px) }
.btn.g{ border-color:var(--line-2); color:var(--ink) }
.btn.g:hover{ border-color:var(--jade); color:var(--jade); transform:translateY(-2px) }

/* ── sections ──────────────────────────────────────────────────────────── */
section.sec{ padding-block:clamp(64px,8vw,104px); position:relative }
section.sec + section.sec{ border-top:1px solid var(--line) }
.eyebrow{ color:var(--jade); margin-bottom:16px }
h2{ font-weight:800; font-size:var(--step-2); line-height:1.03; letter-spacing:-.034em; max-width:21ch; text-wrap:balance }
.sub{ margin-top:16px; color:var(--muted); font-size:16.5px; line-height:1.65; max-width:56ch }

/* ── #for: four fits as a ruled 2×2 grid, field showing through ───────── */
.fits{ margin-top:44px; display:grid; grid-template-columns:1fr 1fr; border-top:1px solid var(--line); border-left:1px solid var(--line) }
.fit{ padding:26px 26px 30px; border-right:1px solid var(--line); border-bottom:1px solid var(--line) }
.fit h3{ font-family:var(--display); font-weight:700; font-size:21px; letter-spacing:-.024em; color:var(--ink) }
.fit p{ margin-top:10px; color:var(--muted); font-size:15px; line-height:1.6; max-width:40ch }
@media (max-width:720px){ .fits{ grid-template-columns:1fr } .fit{ padding:22px 18px 24px } }

/* ── #how: a numbered rail, not another grid ───────────────────────────── */
.steps{ margin-top:44px; list-style:none; padding:0; border-top:1px solid var(--line); counter-reset:step }
.step{
  display:grid; grid-template-columns:72px minmax(200px,1fr) 2fr; gap:10px 28px; align-items:baseline;
  padding:24px 0; border-bottom:1px solid var(--line);
}
.step .n{ color:var(--jade); font-size:13px }
.step h3{ font-family:var(--display); font-weight:700; font-size:22px; letter-spacing:-.024em; color:var(--ink) }
.step p{ color:var(--muted); font-size:15.5px; line-height:1.62; max-width:52ch }
@media (max-width:820px){
  .step{ grid-template-columns:52px 1fr }
  .step p{ grid-column:2 }
}

/* ── #demos: the stance, then the full-bleed deck ──────────────────────── */
.stance{
  margin-top:40px; padding:clamp(26px,4vw,44px); border:1px solid var(--line-2); border-radius:4px;
  background:linear-gradient(150deg, color-mix(in srgb, var(--jade) 10%, transparent), transparent 60%);
}
.stance p{ font-family:var(--display); font-weight:700; font-size:clamp(19px,2.5vw,29px); line-height:1.22; letter-spacing:-.028em; max-width:30ch; text-wrap:balance }
.stance p em{ font-style:normal; color:var(--jade) }
.stance .note{ margin-top:18px; font-family:var(--body); font-weight:400; font-size:15px; line-height:1.62; color:var(--muted); max-width:56ch; letter-spacing:0 }
.deck-wrap{ margin-top:52px }
.deck-foot{ margin-top:8px; display:flex; justify-content:space-between; gap:12px 28px; flex-wrap:wrap; align-items:baseline }
.deck-foot .keys{ color:var(--muted); font-size:13px; line-height:1.5 }
.deck-foot .all{ font-weight:800; font-size:14.5px; color:var(--jade); border-bottom:1px solid transparent; transition:border-color .18s; white-space:nowrap }
.deck-foot .all:hover{ border-bottom-color:var(--jade) }
@media (max-width:719px){ .deck-foot .keys{ display:none } }

/* ── #review ───────────────────────────────────────────────────────────── */
.review{ text-align:center }
.review .copy{ max-width:56ch; margin-inline:auto }
.review h2, .review .sub{ margin-inline:auto }
.say{
  display:inline-block; margin-top:28px; font-family:var(--display); font-size:clamp(21px,3.3vw,33px);
  font-weight:800; letter-spacing:-.03em; color:var(--jade);
  border-bottom:2px solid transparent; transition:border-color .2s;
}
.say:hover{ border-bottom-color:var(--jade) }

/* ── footer ────────────────────────────────────────────────────────────── */
footer{ border-top:1px solid var(--line); padding:44px 0 52px; color:var(--muted); font-size:13px }
.foot{ display:flex; justify-content:space-between; gap:28px 48px; flex-wrap:wrap; align-items:flex-start }
.foot .lead{ max-width:300px }
.foot .lead .mk{ margin-bottom:12px; font-size:16px }
.foot .lead p{ line-height:1.58 }
.foot .cols{ display:flex; gap:12px 28px; flex-wrap:wrap; font-family:var(--mono); font-size:12px; letter-spacing:.04em }
.foot .cols a{ color:var(--muted); transition:color .18s }
.foot .cols a:hover{ color:var(--jade) }
.foot-base{ margin-top:36px; padding-top:20px; border-top:1px solid var(--line); font-family:var(--mono); font-size:11.5px; font-variant-numeric:tabular-nums }
</style>
</Fragment>

<Fragment slot="nav">
<div class="bar">
  <div class="wrap">
    <a class="mk" href="/rewire/landing/" aria-label="Rewire"><i aria-hidden="true"></i><b>Re<span class="t">wire</span></b></a>
    <span class="grow"></span>
    <a class="back" href={nav.back.href}>{nav.back.label}</a>
    <a class="navcta" href={nav.cta.href}>{nav.cta.label}</a>
  </div>
</div>
</Fragment>

<!-- hero -->
<div class="hero" id="s-hero" data-hero data-soma="Hero">
  <div class="wrap">
    <div class="copy" data-quiet>
      <p class="mono kick">{hero.kicker}</p>
      <h1>{hero.headline.lead}<em>{hero.headline.em}</em></h1>
      <p class="lede">{hero.lede}</p>
      <div class="cta">
        <a class="btn p" href={hero.primary.href}>{hero.primary.label} <span class="arw" aria-hidden="true">→</span></a>
        <a class="btn g" href={hero.ghost.href}>{hero.ghost.label}</a>
      </div>
    </div>
  </div>
</div>

<!-- who this is for -->
<section class="sec" id="for" data-soma="Who it's for">
  <div class="wrap">
    <div data-quiet>
      <p class="mono eyebrow">{fits.eyebrow}</p>
      <h2>{fits.heading}</h2>
      <p class="sub">{fits.sub}</p>
    </div>
    <div class="fits">
      {fits.items.map((f) => (
        <div class="fit" data-quiet>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- how it works -->
<section class="sec" id="how" data-soma="How it works">
  <div class="wrap">
    <div data-quiet>
      <p class="mono eyebrow">{how.eyebrow}</p>
      <h2>{how.heading}</h2>
      <p class="sub">{how.sub}</p>
    </div>
    <ol class="steps">
      {how.steps.map((s) => (
        <li class="step" data-quiet>
          <span class="mono n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- demo models -->
<section class="sec" id="demos" data-soma="Demo models">
  <div class="wrap">
    <div data-quiet>
      <p class="mono eyebrow">{demos.eyebrow}</p>
      <h2>{demos.heading}</h2>
    </div>
    <div class="stance">
      <div data-quiet>
        <p>{demos.stance.lead}<em>{demos.stance.em}</em>{demos.stance.tail}</p>
        <p class="note">{demos.note}</p>
      </div>
    </div>
  </div>
  <div class="deck-wrap">
    <DemoDeck />
  </div>
  <div class="wrap">
    <div class="deck-foot" data-quiet>
      <p class="keys">{demos.deck.keys}</p>
      <a class="all" href={demos.all.href}>{demos.all.label} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<!-- free review -->
<section class="sec review" id="review" data-soma="Free review">
  <div class="wrap">
    <div class="copy" data-quiet>
      <p class="mono eyebrow">{review.eyebrow}</p>
      <h2>{review.heading}</h2>
      <p class="sub">{review.sub}</p>
      <a class="say" href={review.cta.href}>{review.cta.label} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<Fragment slot="footer">
<footer>
  <div class="wrap">
    <div class="foot">
      <div class="lead">
        <a class="mk" href="/" aria-label="NeuroTrocity home"><i aria-hidden="true"></i><b>Neuro<span class="t">Trocity</span></b></a>
        <p>{footer.tagline}</p>
      </div>
      <nav class="cols" aria-label="Footer">
        {footer.links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href={`mailto:${footer.email}`}>{footer.email}</a>
      </nav>
    </div>
    <div class="foot-base">{footer.legal}</div>
  </div>
</footer>
</Fragment>

</Base>
