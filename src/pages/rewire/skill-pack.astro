---
import Base from '../../layouts/Base.astro';
import { SKILL_PACK_PAGE } from '../../content/copy';
import { SKILL_PACK } from '../../content/facts';

const { meta, nav, hero, argument, form, contents, craft, hydra, gate, price, faq, dfy, footer } = SKILL_PACK_PAGE;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${SKILL_PACK.name} skill pack`,
  description: meta.description,
  brand: { '@type': 'Organization', name: 'NeuroTrocity' },
  url: meta.canonical,
  offers: {
    '@type': 'Offer',
    price: String(SKILL_PACK.price.amount),
    priceCurrency: SKILL_PACK.price.currency,
    url: SKILL_PACK.checkout,
    availability: 'https://schema.org/InStock',
  },
};
---
<Base title={meta.title} description={meta.description} path="/rewire/skill-pack/" jsonLd={jsonLd} accent="jade">

<Fragment slot="head">
<script is:inline>
  /* Opt in to the reveal animation before first paint, and only when this
     browser can actually run it. Everything stays visible otherwise. */
  (function () {
    try {
      var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('rv-on');
      }
    } catch (e) { /* leave content visible */ }
  })();
</script>
<style is:global>
/* ── ReWire skill pack ───────────────────────────────────────────────────
   Built to the rules it sells. One accent (jade, from the Rewire family), one
   easing token, a mono label role, alpha hairlines rather than solid borders,
   reveals once at top 88%, and no GSAP anywhere — the page is not a demo, so
   nothing here needs a scroll library. */
:root{ --ease: cubic-bezier(.22,1,.36,1); }

a{ text-decoration:none }
.wrap{ max-width:var(--maxw); margin:0 auto; padding-inline:var(--pad) }
.mono{ font-family:var(--mono); font-size:10.5px; letter-spacing:.16em; text-transform:uppercase;
  font-variant-numeric:tabular-nums; line-height:1.6 }
strong{ color:var(--ink); font-weight:700 }

/* ── bar ── */
body > header:has(.bar){ position:sticky; top:0; z-index:10;
  background:color-mix(in srgb, var(--ground) 66%, transparent);
  backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  border-bottom:1px solid var(--line) }
.bar .wrap{ display:flex; align-items:center; gap:18px; height:66px }
.mk{ display:inline-flex; align-items:center; gap:9px; font-weight:800; font-size:18px;
  letter-spacing:-.03em; color:var(--ink) }
.mk i{ width:9px; height:9px; border-radius:50%; background:var(--jade);
  box-shadow:0 0 12px var(--jade); display:block; flex:none }
.grow{ flex:1 }
.back{ font-size:14px; color:var(--muted); transition:color .18s var(--ease) }
.back:hover{ color:var(--ink) }
.navcta{ font-size:13.5px; font-weight:800; padding:9px 16px; border-radius:999px; color:var(--ink);
  white-space:nowrap; border:1px solid color-mix(in srgb, var(--jade) 45%, transparent);
  background:color-mix(in srgb, var(--jade) 12%, transparent);
  transition:background .18s var(--ease), border-color .18s var(--ease) }
.navcta:hover{ background:color-mix(in srgb, var(--jade) 26%, transparent); border-color:var(--jade) }

/* ── type ── */
section.sec{ padding-block:clamp(58px,7.5vw,100px) }
section.sec + section.sec{ border-top:1px solid var(--line) }
.eyebrow{ color:var(--jade); margin-bottom:16px }
h2{ font-weight:800; font-size:var(--step-2); line-height:1.04; letter-spacing:-.034em;
  max-width:20ch; text-wrap:balance }
.sub{ margin-top:16px; color:var(--muted); font-size:16.5px; line-height:1.65; max-width:58ch }

/* ── hero ── */
.hero{ padding-block:clamp(64px,9vw,104px) }
.hero .kick{ color:var(--jade); margin-bottom:20px }
.hero h1{ font-weight:800; font-size:var(--step-3); line-height:.99; letter-spacing:-.036em;
  max-width:16ch; text-wrap:balance }
.hero h1 em{ font-style:normal; color:var(--jade) }
.hero .lede{ margin-top:24px; max-width:54ch; color:var(--muted);
  font-size:clamp(15.5px,1.5vw,17.5px); line-height:1.64 }
.cta{ margin-top:32px; display:flex; gap:11px; flex-wrap:wrap; align-items:center }
.btn{ display:inline-flex; align-items:center; gap:9px; font-size:14.5px; font-weight:800;
  padding:13px 21px; border-radius:6px; border:1px solid transparent; font-family:var(--body);
  transition:transform .18s var(--ease), background .18s var(--ease), border-color .18s var(--ease), color .18s var(--ease) }
.btn .arw{ transition:transform .25s var(--ease) }
.btn:hover .arw{ transform:translateX(4px) }
.btn.p{ background:var(--jade); color:var(--ground) }
.btn.p:hover{ background:color-mix(in srgb, var(--jade) 86%, white); transform:translateY(-2px) }
.btn.g{ border-color:var(--line-2); color:var(--ink) }
.btn.g:hover{ border-color:var(--jade); color:var(--jade); transform:translateY(-2px) }
.hero .note{ margin-top:18px; color:var(--dim); font-size:13.5px; max-width:46ch; line-height:1.6 }

/* ── argument: prose, deliberately not a grid ── */
.arg{ margin-top:38px; max-width:62ch; display:grid; gap:18px }
.arg p{ color:var(--muted); font-size:16.5px; line-height:1.7 }
.arg p:last-child{ color:var(--ink); font-weight:700 }

/* ── ruled lists ── */
.rows{ margin-top:40px; border-top:1px solid var(--line); list-style:none; padding:0 }
.row{ display:grid; grid-template-columns:minmax(190px,.9fr) 2fr; gap:10px 32px;
  padding:22px 0; border-bottom:1px solid var(--line); align-items:baseline }
.row h3{ font-family:var(--display); font-weight:700; font-size:19.5px; letter-spacing:-.022em; color:var(--ink) }
.row p{ color:var(--muted); font-size:15.5px; line-height:1.65; max-width:58ch }
@media (max-width:760px){ .row{ grid-template-columns:1fr; gap:8px } }

/* ── craft rules: mono rule as the label, body beneath ── */
.rules{ margin-top:40px; display:grid; gap:1px; background:var(--line);
  border:1px solid var(--line); border-radius:4px; overflow:hidden }
.rule{ background:var(--ground); padding:24px clamp(18px,2.4vw,28px) }
.rule .k{ color:var(--jade); display:block; margin-bottom:11px }
.rule p{ color:var(--muted); font-size:15.5px; line-height:1.66; max-width:70ch }
.proof{ margin-top:22px; color:var(--ink); font-size:15.5px; line-height:1.66; max-width:62ch;
  padding-left:16px; border-left:2px solid var(--jade) }

/* ── gate ── */
.gate{ margin-top:40px; display:grid; grid-template-columns:1fr 1.35fr; gap:clamp(24px,4vw,56px) }
@media (max-width:820px){ .gate{ grid-template-columns:1fr } }
.need{ padding:24px; border:1px solid var(--line-2); border-radius:4px;
  background:linear-gradient(150deg, color-mix(in srgb, var(--jade) 9%, transparent), transparent 62%) }
.need ul{ margin:14px 0 0; padding:0; list-style:none; display:grid; gap:10px }
.need li{ color:var(--ink); font-size:15.5px; line-height:1.5; display:flex; gap:10px }
.need li::before{ content:'\2713'; color:var(--jade); flex:none }
.need .n{ margin-top:16px; color:var(--dim); font-size:13.5px; line-height:1.6 }

/* ── price ── */
.pricebox{ margin-top:40px; border:1px solid var(--line-2); border-radius:6px; overflow:hidden }
.pricehead{ padding:clamp(24px,3.4vw,36px); display:flex; flex-wrap:wrap; gap:18px 40px;
  align-items:baseline; border-bottom:1px solid var(--line);
  background:linear-gradient(150deg, color-mix(in srgb, var(--jade) 11%, transparent), transparent 60%) }
.amt{ font-family:var(--display); font-weight:800; font-size:clamp(38px,6vw,60px);
  line-height:1; letter-spacing:-.04em; color:var(--ink) }
.amt sup{ font-size:.42em; font-weight:700; vertical-align:super; margin-right:2px; color:var(--muted) }
.amt .cur{ font-size:.3em; font-weight:700; color:var(--muted); margin-left:8px; letter-spacing:0 }
.pricehead .pn{ color:var(--muted); font-size:14.5px; line-height:1.6; max-width:30ch }
.priceinc{ padding:clamp(22px,3vw,32px); display:grid; gap:11px }
.priceinc li{ list-style:none; color:var(--ink); font-size:15.5px; display:flex; gap:11px; line-height:1.55 }
.priceinc li::before{ content:'\2713'; color:var(--jade); flex:none }
.priceinc .go{ margin-top:8px }
.guar{ margin-top:28px; padding:22px 24px; border:1px solid var(--line); border-radius:4px }
.guar h3{ font-family:var(--display); font-weight:700; font-size:18px; color:var(--ink); letter-spacing:-.02em }
.guar p{ margin-top:9px; color:var(--muted); font-size:15px; line-height:1.66; max-width:66ch }
.honest{ margin-top:18px; color:var(--dim); font-size:14px; line-height:1.66; max-width:66ch }

/* ── faq ── */
.faq{ margin-top:38px; border-top:1px solid var(--line) }
.faq details{ border-bottom:1px solid var(--line) }
.faq summary{ cursor:pointer; list-style:none; padding:19px 40px 19px 0; position:relative;
  font-family:var(--display); font-weight:700; font-size:17.5px; letter-spacing:-.02em; color:var(--ink) }
.faq summary::-webkit-details-marker{ display:none }
.faq summary::after{ content:''; position:absolute; right:6px; top:50%; width:9px; height:9px;
  border-right:1.5px solid var(--muted); border-bottom:1.5px solid var(--muted);
  translate:0 -60%; rotate:45deg; transition:rotate .22s var(--ease), border-color .22s var(--ease) }
.faq details[open] summary::after{ rotate:-135deg; border-color:var(--jade) }
.faq summary:hover{ color:var(--jade) }
.faq .a{ padding:0 0 22px; color:var(--muted); font-size:15.5px; line-height:1.7; max-width:68ch }

/* ── dfy + footer ── */
.dfy{ background:var(--ground-2) }
footer.ft{ border-top:1px solid var(--line); padding-block:40px; color:var(--dim); font-size:14px }
.ft .wrap{ display:flex; flex-wrap:wrap; gap:14px 28px; align-items:center }
.ft a{ color:var(--muted); transition:color .18s var(--ease) }
.ft a:hover{ color:var(--jade) }
.ft .legal{ width:100%; color:var(--dim); font-size:13px }

/* ── reveals ──────────────────────────────────────────────────────────────
   Progressive enhancement, deliberately. Content is VISIBLE by default and is
   only hidden once the head script has confirmed it can reveal it again. Any
   failure — no JS, a blocked module, an IntersectionObserver that never
   delivers a callback — leaves a fully readable page rather than a blank one.
   A sales page that renders empty because an observer did not fire is not a
   trade worth making for a fade. */
html.rv-on .rv{ opacity:0; translate:0 14px;
  transition:opacity .6s var(--ease), translate .6s var(--ease) }
html.rv-on .rv.in{ opacity:1; translate:0 0 }
@media (prefers-reduced-motion: reduce){
  html.rv-on .rv{ opacity:1; translate:0 0; transition:none }
  *{ animation:none !important }
}
</style>
</Fragment>

<nav class="bar" slot="nav">
  <div class="wrap">
    <a class="mk" href="/rewire/skill-pack/"><i></i>ReWire</a>
    <span class="grow"></span>
    <a class="back" href={nav.back.href}>{nav.back.label}</a>
    <a class="navcta" href={nav.cta.href}>{nav.cta.label}</a>
  </div>
</nav>

<section class="hero">
  <div class="wrap">
    <p class="mono kick">{hero.kicker}</p>
    <h1>{hero.headline.lead}<em>{hero.headline.em}</em></h1>
    <p class="lede">{hero.lede}</p>
    <div class="cta">
      <a class="btn p" href={hero.primary.href}>{hero.primary.label}<span class="arw">&rarr;</span></a>
      <a class="btn g" href={hero.ghost.href}>{hero.ghost.label}</a>
    </div>
    <p class="note">{hero.note}</p>
  </div>
</section>

<section class="sec">
  <div class="wrap rv">
    <p class="mono eyebrow">{argument.eyebrow}</p>
    <h2>{argument.heading}</h2>
    <div class="arg">{argument.body.map((t) => <p>{t}</p>)}</div>
  </div>
</section>

<section class="sec">
  <div class="wrap rv">
    <p class="mono eyebrow">{form.eyebrow}</p>
    <h2>{form.heading}</h2>
    <p class="sub">{form.sub}</p>
    <ul class="rows">
      {form.points.map((p) => (
        <li class="row"><h3>{p.title}</h3><p>{p.body}</p></li>
      ))}
    </ul>
  </div>
</section>

<section class="sec">
  <div class="wrap rv">
    <p class="mono eyebrow">{contents.eyebrow}</p>
    <h2>{contents.heading}</h2>
    <ul class="rows">
      {contents.items.map((c) => (
        <li class="row"><h3>{c.title}</h3><p>{c.body}</p></li>
      ))}
    </ul>
  </div>
</section>

<section class="sec">
  <div class="wrap rv">
    <p class="mono eyebrow">{craft.eyebrow}</p>
    <h2>{craft.heading}</h2>
    <p class="sub">{craft.sub}</p>
    <div class="rules">
      {craft.rules.map((r) => (
        <div class="rule"><span class="mono k">{r.rule}</span><p>{r.body}</p></div>
      ))}
    </div>
    <p class="proof">{craft.proof}</p>
  </div>
</section>

<section class="sec">
  <div class="wrap rv">
    <p class="mono eyebrow">{hydra.eyebrow}</p>
    <h2>{hydra.heading}</h2>
    <p class="sub">{hydra.body}</p>
  </div>
</section>

<section class="sec">
  <div class="wrap rv">
    <p class="mono eyebrow">{gate.eyebrow}</p>
    <h2>{gate.heading}</h2>
    <p class="sub">{gate.sub}</p>
    <div class="gate">
      <div class="need">
        <p class="mono" style="color:var(--jade)">You need</p>
        <ul>{gate.prerequisites.map((p) => <li>{p}</li>)}</ul>
        <p class="n">{gate.prereqNote}</p>
      </div>
      <ul class="rows" style="margin-top:0">
        {gate.notFor.map((n) => (
          <li class="row"><h3>{n.title}</h3><p>{n.body}</p></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap rv">
    <p class="mono eyebrow">{price.eyebrow}</p>
    <h2>{price.heading}</h2>
    <div class="pricebox">
      <div class="pricehead">
        <p class="amt"><sup>$</sup>{price.amount.amount}<span class="cur">{price.amount.currency}</span></p>
        <p class="pn">{price.amount.note}</p>
      </div>
      <ul class="priceinc">
        {price.includes.map((i) => <li>{i}</li>)}
        <li class="go" style="display:block">
          <a class="btn p" href={SKILL_PACK.checkout}>Get the pack<span class="arw">&rarr;</span></a>
        </li>
      </ul>
    </div>
    <div class="guar">
      <h3>{price.guarantee.title}</h3>
      <p>{price.guarantee.body}</p>
    </div>
    <p class="honest">{price.honest}</p>
  </div>
</section>

<section class="sec">
  <div class="wrap rv">
    <p class="mono eyebrow">{faq.eyebrow}</p>
    <h2>{faq.heading}</h2>
    <div class="faq">
      {faq.items.map((f) => (
        <details><summary>{f.q}</summary><div class="a">{f.a}</div></details>
      ))}
    </div>
  </div>
</section>

<section class="sec dfy">
  <div class="wrap rv">
    <p class="mono eyebrow">{dfy.eyebrow}</p>
    <h2>{dfy.heading}</h2>
    <p class="sub">{dfy.sub}</p>
    <div class="cta"><a class="btn g" href={dfy.cta.href}>{dfy.cta.label}<span class="arw">&rarr;</span></a></div>
  </div>
</section>

<footer class="ft" slot="footer">
  <div class="wrap">
    <span>{footer.tagline}</span>
    <span class="grow"></span>
    {footer.links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href={`mailto:${footer.email}`}>{footer.email}</a>
    <span class="legal">{footer.legal}</span>
  </div>
</footer>

<script>
  /* Reveals fire as the element enters, once, and never re-run — taste §3.
     Three ways out, because the only unacceptable outcome is hidden content:
       1. the observer, which is the intended path;
       2. anything already in view on load, revealed immediately;
       3. a failsafe timer that gives up and shows everything.
     If the html.rv-on class was never added, none of this matters — the CSS
     never hid anything in the first place. */
  const els = Array.from(document.querySelectorAll<HTMLElement>('.rv'));
  const show = (el: Element) => el.classList.add('in');

  if (!document.documentElement.classList.contains('rv-on')) {
    els.forEach(show);
  } else {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        show(e.target);
        io.unobserve(e.target);            // once: true
      }
    }, { rootMargin: '0px 0px -12% 0px' }); // ≈ top 88%

    els.forEach((el) => {
      const r = el.getBoundingClientRect();
      if (r.top < innerHeight * 0.88) show(el);   // already on screen at load
      else io.observe(el);
    });

    /* If no callback has arrived by now, the observer is not going to work
       here. Show everything rather than leave the page half-blank. */
    setTimeout(() => {
      if (els.some((el) => !el.classList.contains('in'))) els.forEach(show);
    }, 1600);
  }
</script>

</Base>
