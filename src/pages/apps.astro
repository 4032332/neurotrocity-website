---
import Base from '../layouts/Base.astro';
import { APPS_PAGE } from '../content/copy';

const { meta, nav, hero, apps, contact, footer } = APPS_PAGE;

// The two apps, straight from PRODUCTS (Rewire is a service and has its own page).

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: meta.title,
  description: meta.description,
  url: meta.canonical,
  isPartOf: { '@type': 'WebSite', name: 'NeuroTrocity', url: 'https://neurotrocity.com/' },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: apps.items.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'SoftwareApplication',
        name: a.name,
        url: `https://neurotrocity.com${a.path}`,
        applicationCategory: 'MobileApplication',
      },
    })),
  },
};
---
<Base title={meta.title} description={meta.description} path="/apps/" ogImage="/og/apps.png" jsonLd={jsonLd} accent="violet" field spine>

<Fragment slot="head">
<style is:global>
/* ── frame ─────────────────────────────────────────────────────────────── */
a{ text-decoration:none }
.wrap{ max-width:var(--maxw); margin:0 auto; padding-inline:var(--pad) }
@media (min-width:1001px){ .wrap{ padding-left:calc(var(--gutter) + 16px) } }
.mono{ font-family:var(--mono); font-size:11px; letter-spacing:.16em; text-transform:uppercase; font-variant-numeric:tabular-nums }
strong{ color:var(--ink); font-weight:700 }

/* ── nav bar (Base renders the <header>; this styles it) ───────────────── */
body > header:has(.bar){
  position:sticky; top:0; z-index:10;
  background:color-mix(in srgb, var(--ground) 62%, transparent);
  backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  border-bottom:1px solid transparent;
}
@supports (animation-timeline: scroll()){
  body > header:has(.bar){ animation:bar-on linear both; animation-timeline:scroll(root); animation-range:0 40px }
  @keyframes bar-on{ from{ border-bottom-color:transparent } to{ border-bottom-color:var(--line) } }
}
.bar .wrap{ display:flex; align-items:center; gap:18px; height:66px }
.mk{ display:inline-flex; align-items:center; gap:9px; font-weight:800; font-size:18px; letter-spacing:-.03em; color:var(--ink) }
.mk i{ width:9px; height:9px; border-radius:50%; background:var(--violet); box-shadow:0 0 12px var(--violet); display:block; flex:none }
.mk .t{ color:var(--violet) }
.grow{ flex:1 }
.nav{ display:flex; gap:22px; font-size:14px; color:var(--muted) }
.nav a{ transition:color .18s }
.nav a:hover{ color:var(--ink) }
@media (max-width:820px){ .nav{ display:none } }
.navcta{
  font-size:13.5px; font-weight:800; padding:9px 16px; border-radius:999px; color:var(--ink); white-space:nowrap;
  border:1px solid color-mix(in srgb, var(--violet) 45%, transparent);
  background:color-mix(in srgb, var(--violet) 12%, transparent);
  transition:background .18s, border-color .18s;
}
.navcta:hover{ background:color-mix(in srgb, var(--violet) 26%, transparent); border-color:var(--violet) }
@media (max-width:420px){ .bar .wrap{ gap:12px } }

/* ── hero ──────────────────────────────────────────────────────────────── */
.hero{ min-height:min(72vh,640px); display:flex; align-items:center; padding-block:70px }
/* .wrap is a flex item here, so it sizes to its content rather than honouring
   max-width, and margin:0 auto then centres the shrunken box — which put the
   banner 228px to the right of every section below it. Fill the line instead. */
.hero .wrap{ width:100% }
.hero .copy{ max-width:100% }
.hero .kick{ color:var(--ember); margin-bottom:20px }
.hero h1{ font-weight:800; font-size:var(--step-3); line-height:.99; letter-spacing:-.036em; max-width:15ch; text-wrap:balance }
.hero h1 em{ font-style:normal; color:var(--violet) }
.hero .sub{
  margin-top:18px; max-width:46ch; color:var(--ink); font-weight:500;
  font-size:clamp(17px,1.9vw,21px); line-height:1.4; letter-spacing:-.012em;
  text-wrap:balance;
}
.hero .lede{ margin-top:18px; max-width:64ch; color:var(--muted); font-size:clamp(15.5px,1.5vw,17.5px); line-height:1.64 }
.cta{ margin-top:32px; display:flex; gap:11px; flex-wrap:wrap }
.btn{
  display:inline-flex; align-items:center; gap:9px; font-size:14.5px; font-weight:800;
  padding:13px 21px; border-radius:6px; border:1px solid transparent; font-family:var(--body);
  transition:transform .18s, background .18s, border-color .18s, color .18s;
}
.btn .arw{ transition:transform .25s }
.btn:hover .arw{ transform:translateX(4px) }
/* Ember is a light accent: the primary button takes dark ink, not white. */
.btn.p{ background:var(--violet); color:#fff }
.btn.p:hover{ background:color-mix(in srgb, var(--violet) 88%, white); transform:translateY(-2px) }
.btn.g{ border-color:var(--line-2); color:var(--ink) }
.btn.g:hover{ border-color:var(--violet); color:var(--violet); transform:translateY(-2px) }

/* ── sections ──────────────────────────────────────────────────────────── */
section.sec{ padding-block:clamp(64px,8vw,104px); position:relative }
section.sec + section.sec{ border-top:1px solid var(--line) }
.eyebrow{ color:var(--muted); margin-bottom:16px }
h2{ font-weight:800; font-size:var(--step-2); line-height:1.03; letter-spacing:-.034em; max-width:21ch; text-wrap:balance }
.sub{ margin-top:16px; color:var(--muted); font-size:16.5px; line-height:1.65; max-width:56ch }

/* ── #apps: two equal tiles, each carrying the app's own artwork ──────────
   Equal by construction, not by coincidence: one column each, a shared art
   frame with a fixed aspect ratio, and the body stretched so the footers of
   both tiles sit on the same line whatever the copy length. */
.apps{ margin-top:40px; display:grid; gap:20px; grid-template-columns:1fr 1fr }
.app{
  display:flex; flex-direction:column; position:relative; overflow:hidden;
  border:1px solid var(--line); border-radius:8px;
  background:color-mix(in srgb, var(--ground-2) 80%, transparent);
  color:inherit; transition:border-color .25s, background .25s, transform .25s;
}
.app:hover, .app:focus-visible{
  border-color:color-mix(in srgb, var(--c) 58%, transparent);
  background:color-mix(in srgb, var(--c) 8%, var(--ground-2));
  transform:translateY(-3px);
}

.app .art{
  display:block; position:relative; aspect-ratio:4/3; overflow:hidden;
  border-bottom:1px solid var(--line);
  background:
    radial-gradient(68% 76% at 50% 42%, color-mix(in srgb, var(--c) 26%, transparent), transparent 70%),
    color-mix(in srgb, var(--ground) 82%, transparent);
}
.app .art img{
  width:100%; height:100%; display:block;
  transition:transform .5s cubic-bezier(.22,1,.36,1);
}
/* Milli is cut out, so she floats on the tint; the DisPoint plate is a
   photograph of its own screen and fills the frame. */
.app .art[data-fit="contain"] img{ object-fit:contain; padding:3.5% 3.5% 2% }
.app .art[data-fit="cover"] img{ object-fit:cover; object-position:50% 50% }
.app:hover .art img, .app:focus-visible .art img{ transform:scale(1.04) }

.app .body{ display:flex; flex-direction:column; flex:1; padding:22px 22px 24px }
.app .sl{ color:var(--c); display:block }
.app h3{ margin-top:10px; font-weight:800; letter-spacing:-.03em; color:var(--ink); font-size:clamp(22px,2.3vw,28px) }
.app p{ margin-top:10px; color:var(--muted); font-size:15px; line-height:1.6 }
.app:hover p, .app:focus-visible p{ color:var(--ink) }
.app .row{ margin-top:auto; padding-top:22px; display:flex; align-items:baseline; gap:14px 20px; flex-wrap:wrap }
.app .mt{ font-family:var(--mono); font-size:10.5px; color:var(--muted); letter-spacing:.09em }
.app .go{ margin-left:auto; font-family:var(--mono); font-size:12.5px; color:var(--c); letter-spacing:.08em; text-transform:uppercase }
.app .go .arw{ display:inline-block; transition:transform .25s }
.app:hover .go .arw, .app:focus-visible .go .arw{ transform:translateX(4px) }

@media (max-width:860px){ .apps{ grid-template-columns:1fr } }

@media (prefers-reduced-motion:reduce){
  .app, .app .art img{ transition:none }
  .app:hover, .app:focus-visible{ transform:none }
  .app:hover .art img, .app:focus-visible .art img{ transform:none }
}

/* ── #contact ──────────────────────────────────────────────────────────── */
.contact{ text-align:center }
.contact .copy{ max-width:56ch; margin-inline:auto }
.contact h2, .contact .sub{ margin-inline:auto }
.say{
  display:inline-block; margin-top:28px; font-family:var(--display); font-size:clamp(21px,3.3vw,33px);
  font-weight:800; letter-spacing:-.03em; color:var(--violet); overflow-wrap:anywhere;
  border-bottom:2px solid transparent; transition:border-color .2s;
}
.say:hover{ border-bottom-color:var(--violet) }

/* ── stance — what this page is, and is not, proof of ──────────────────── */
.stance{
  margin-top:26px; padding:clamp(26px,4vw,44px); border:1px solid var(--line-2); border-radius:4px;
  background:
    linear-gradient(150deg,
      color-mix(in srgb, var(--violet) 10%, transparent),
      color-mix(in srgb, var(--ember) 3%, transparent) 55%, transparent);
}
.stance p{ font-family:var(--display); font-weight:700; font-size:clamp(19px,2.5vw,29px); line-height:1.22; letter-spacing:-.028em; max-width:26ch; text-wrap:balance }
.stance p em{ font-style:normal; color:var(--violet) }
.stance .note{ margin-top:18px; font-family:var(--body); font-weight:400; font-size:15px; line-height:1.62; color:var(--muted); max-width:56ch; letter-spacing:0; text-wrap:pretty }

/* ── footer ────────────────────────────────────────────────────────────── */
footer{ border-top:1px solid var(--line); padding:44px 0 52px; color:var(--muted); font-size:13px }
.foot{ display:flex; justify-content:space-between; gap:28px 48px; flex-wrap:wrap; align-items:flex-start }
.foot .lead{ max-width:280px }
.foot .lead .mk{ margin-bottom:12px; font-size:16px }
.foot .lead p{ line-height:1.58 }
.foot .cols{ display:flex; gap:12px 28px; flex-wrap:wrap; font-family:var(--mono); font-size:12px; letter-spacing:.04em }
.foot .cols a{ color:var(--muted); transition:color .18s }
.foot .cols a:hover{ color:var(--violet) }
.foot-base{ margin-top:36px; padding-top:20px; border-top:1px solid var(--line); font-family:var(--mono); font-size:11.5px; font-variant-numeric:tabular-nums }
</style>
</Fragment>

<Fragment slot="nav">
<div class="bar">
  <div class="wrap">
    <a class="mk" href="/" aria-label="NeuroTrocity home"><i aria-hidden="true"></i><b>Neuro<span class="t">Trocity</span></b></a>
    <span class="grow"></span>
    <nav class="nav" aria-label="Primary">
      <a href={nav.back.href}>{nav.back.label}</a>
      {nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="navcta" href={nav.cta.href}>{nav.cta.label}</a>
  </div>
</div>
</Fragment>

<!-- hero -->
<div class="hero" id="s-hero" data-hero data-soma="Hero">
  <div class="wrap">
    <div class="copy" data-quiet>
      <p class="mono kick">{hero.kicker}</p>
      <h1>{hero.headline.lead}<em>{hero.headline.em}</em></h1>
      <p class="sub">{hero.sub}</p>
      <p class="lede">{hero.lede.a}<strong>{hero.lede.strong}</strong>{hero.lede.b}</p>
      <div class="cta">
        <a class="btn p" href={hero.primary.href}>{hero.primary.label} <span class="arw" aria-hidden="true">→</span></a>
        <a class="btn g" href={hero.ghost.href}>{hero.ghost.label}</a>
      </div>
    </div>
  </div>
</div>

<!-- the proof -->
<section class="sec" id="apps" data-soma="The proof">
  <div class="wrap">
    <div data-quiet>
      <p class="mono eyebrow">{apps.eyebrow}</p>
    </div>
    <div class="stance">
      <div data-quiet>
        <p>{apps.stance.lead}<em>{apps.stance.em}</em></p>
        <p class="note">{apps.stance.note}</p>
      </div>
    </div>
    <div class="apps">
      {apps.items.map((a) => {
        const art = apps.art[a.slug];
        return (
          <a class="app" href={a.path} style={`--c:var(--${a.accent})`} data-quiet>
            <span class="art" data-fit={art.fit}>
              <img src={art.src} alt={art.alt} width="1040" height="780"
                   loading="lazy" decoding="async" />
            </span>
            <span class="body">
              <span class="mono sl">/{a.slug}</span>
              <h3>{a.name}</h3>
              <p>{a.description}</p>
              <span class="row">
                <span class="mt">{a.platforms}</span>
                <span class="go">{apps.open} <span class="arw" aria-hidden="true">→</span></span>
              </span>
            </span>
          </a>
        );
      })}
    </div>
  </div>
</section>

<section class="sec contact" id="contact" data-soma="Contact">
  <div class="wrap">
    <div class="copy" data-quiet>
      <p class="mono eyebrow">{contact.eyebrow}</p>
      <h2>{contact.heading}</h2>
      <p class="sub">{contact.sub}</p>
      <a class="say" href={`mailto:${contact.email}`}>{contact.email}</a>
    </div>
  </div>
</section>

<Fragment slot="footer">
<footer>
  <div class="wrap">
    <div class="foot">
      <div class="lead">
        <a class="mk" href="/" aria-label="NeuroTrocity home"><i aria-hidden="true"></i><b>Neuro<span class="t">Trocity</span></b></a>
        <p>{footer.tagline}</p>
      </div>
      <nav class="cols" aria-label="Footer">
        {footer.links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href={`mailto:${footer.email}`}>{footer.email}</a>
      </nav>
    </div>
    <div class="foot-base">{footer.legal}</div>
  </div>
</footer>
</Fragment>

</Base>
