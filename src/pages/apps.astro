---
import Base from '../layouts/Base.astro';
import { RULES } from '../content/facts';
import { APPS_PAGE } from '../content/copy';

const { meta, nav, hero, apps, rules, contact, footer } = APPS_PAGE;

// The two apps, straight from PRODUCTS (Rewire is a service and has its own page).
const [lead, ...rest] = apps.items;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: meta.title,
  description: meta.description,
  url: meta.canonical,
  isPartOf: { '@type': 'WebSite', name: 'NeuroTrocity', url: 'https://neurotrocity.com/' },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: apps.items.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'SoftwareApplication',
        name: a.name,
        url: `https://neurotrocity.com${a.path}`,
        applicationCategory: 'MobileApplication',
      },
    })),
  },
};
---
<Base title={meta.title} description={meta.description} path="/apps/" ogImage="/og/apps.png" jsonLd={jsonLd} accent="ember" field spine>

<Fragment slot="head">
<style is:global>
/* ── frame ─────────────────────────────────────────────────────────────── */
a{ text-decoration:none }
.wrap{ max-width:var(--maxw); margin:0 auto; padding-inline:var(--pad) }
@media (min-width:1001px){ .wrap{ padding-left:calc(var(--gutter) + 16px) } }
.mono{ font-family:var(--mono); font-size:11px; letter-spacing:.16em; text-transform:uppercase; font-variant-numeric:tabular-nums }
strong{ color:var(--ink); font-weight:700 }

/* ── nav bar (Base renders the <header>; this styles it) ───────────────── */
body > header:has(.bar){
  position:sticky; top:0; z-index:10;
  background:color-mix(in srgb, var(--ground) 62%, transparent);
  backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  border-bottom:1px solid transparent;
}
@supports (animation-timeline: scroll()){
  body > header:has(.bar){ animation:bar-on linear both; animation-timeline:scroll(root); animation-range:0 40px }
  @keyframes bar-on{ from{ border-bottom-color:transparent } to{ border-bottom-color:var(--line) } }
}
.bar .wrap{ display:flex; align-items:center; gap:18px; height:66px }
.mk{ display:inline-flex; align-items:center; gap:9px; font-weight:800; font-size:18px; letter-spacing:-.03em; color:var(--ink) }
.mk i{ width:9px; height:9px; border-radius:50%; background:var(--ember); box-shadow:0 0 12px var(--ember); display:block; flex:none }
.mk .t{ color:var(--ember) }
.grow{ flex:1 }
.nav{ display:flex; gap:22px; font-size:14px; color:var(--muted) }
.nav a{ transition:color .18s }
.nav a:hover{ color:var(--ink) }
@media (max-width:820px){ .nav{ display:none } }
.navcta{
  font-size:13.5px; font-weight:800; padding:9px 16px; border-radius:999px; color:var(--ink); white-space:nowrap;
  border:1px solid color-mix(in srgb, var(--ember) 45%, transparent);
  background:color-mix(in srgb, var(--ember) 12%, transparent);
  transition:background .18s, border-color .18s;
}
.navcta:hover{ background:color-mix(in srgb, var(--ember) 26%, transparent); border-color:var(--ember) }
@media (max-width:420px){ .bar .wrap{ gap:12px } }

/* ── hero ──────────────────────────────────────────────────────────────── */
.hero{ min-height:min(80vh,700px); display:flex; align-items:center; padding-block:70px }
.hero .copy{ width:fit-content; max-width:100% }
.hero .kick{ color:var(--cyan); margin-bottom:20px }
.hero h1{ font-weight:800; font-size:var(--step-3); line-height:.99; letter-spacing:-.036em; max-width:15ch; text-wrap:balance }
.hero h1 em{ font-style:normal; color:var(--ember) }
.hero .lede{ margin-top:24px; max-width:47ch; color:var(--muted); font-size:clamp(15.5px,1.5vw,17.5px); line-height:1.64 }
.cta{ margin-top:32px; display:flex; gap:11px; flex-wrap:wrap }
.btn{
  display:inline-flex; align-items:center; gap:9px; font-size:14.5px; font-weight:800;
  padding:13px 21px; border-radius:6px; border:1px solid transparent; font-family:var(--body);
  transition:transform .18s, background .18s, border-color .18s, color .18s;
}
.btn .arw{ transition:transform .25s }
.btn:hover .arw{ transform:translateX(4px) }
/* Ember is a light accent: the primary button takes dark ink, not white. */
.btn.p{ background:var(--ember); color:#1A0B03 }
.btn.p:hover{ background:color-mix(in srgb, var(--ember) 88%, white); transform:translateY(-2px) }
.btn.g{ border-color:var(--line-2); color:var(--ink) }
.btn.g:hover{ border-color:var(--cyan); color:var(--cyan); transform:translateY(-2px) }

/* ── sections ──────────────────────────────────────────────────────────── */
section.sec{ padding-block:clamp(64px,8vw,104px); position:relative }
section.sec + section.sec{ border-top:1px solid var(--line) }
.eyebrow{ color:var(--muted); margin-bottom:16px }
h2{ font-weight:800; font-size:var(--step-2); line-height:1.03; letter-spacing:-.034em; max-width:21ch; text-wrap:balance }
.sub{ margin-top:16px; color:var(--muted); font-size:16.5px; line-height:1.65; max-width:56ch }

/* ── #apps: one lead tile, the rest secondary ─────────────────────────────
   Deliberately auto-flowing: two apps fill the block completely, and a third
   or a sixth extends the secondary row rather than leaving empty cells. */
.apps{ margin-top:44px; display:grid; gap:18px }
.app{
  display:block; position:relative; border:1px solid var(--line); border-radius:6px;
  background:color-mix(in srgb, var(--ground-2) 78%, transparent);
  padding:26px 24px 28px; color:inherit;
  transition:border-color .2s, background .2s, transform .2s;
}
.app:hover, .app:focus-visible{
  border-color:color-mix(in srgb, var(--c) 55%, transparent);
  background:color-mix(in srgb, var(--c) 7%, var(--ground-2));
  transform:translateY(-2px);
}
.app .sl{ color:var(--c); display:block }
.app h3{ margin-top:12px; font-weight:800; letter-spacing:-.03em; color:var(--ink); font-size:24px }
.app p{ margin-top:10px; color:var(--muted); font-size:15px; line-height:1.6; max-width:52ch }
.app:hover p, .app:focus-visible p{ color:var(--ink) }
.app .row{ margin-top:20px; display:flex; align-items:baseline; gap:14px 20px; flex-wrap:wrap }
.app .mt{ font-family:var(--mono); font-size:10.5px; color:var(--muted); letter-spacing:.09em }
.app .go{ margin-left:auto; font-family:var(--mono); font-size:12.5px; color:var(--c); letter-spacing:.08em; text-transform:uppercase }
.app .go .arw{ display:inline-block; transition:transform .25s }
.app:hover .go .arw, .app:focus-visible .go .arw{ transform:translateX(4px) }

.app.is-lead{
  padding:clamp(28px,4vw,44px) clamp(24px,3.4vw,40px);
  border-color:var(--line-2);
  background:
    linear-gradient(150deg,
      color-mix(in srgb, var(--c) 11%, transparent),
      color-mix(in srgb, var(--cyan) 3%, transparent) 58%, transparent),
    color-mix(in srgb, var(--ground-2) 78%, transparent);
}
.app.is-lead h3{ font-size:clamp(30px,4.4vw,44px); letter-spacing:-.035em }
.app.is-lead p{ font-size:clamp(16px,1.5vw,18px); max-width:44ch }
.apps .rest{ display:grid; gap:18px; grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr)) }

/* ── #rules ────────────────────────────────────────────────────────────── */
.rules{ margin-top:40px; border-top:1px solid var(--line); list-style:none; padding:0 }
.rule{ padding:21px 0; border-bottom:1px solid var(--line); font-size:15.5px; line-height:1.64; color:var(--muted); max-width:76ch }
.rule b{ color:var(--ink); font-weight:800 }

/* ── #contact ──────────────────────────────────────────────────────────── */
.contact{ text-align:center }
.contact .copy{ max-width:56ch; margin-inline:auto }
.contact h2, .contact .sub{ margin-inline:auto }
.say{
  display:inline-block; margin-top:28px; font-family:var(--display); font-size:clamp(21px,3.3vw,33px);
  font-weight:800; letter-spacing:-.03em; color:var(--ember); overflow-wrap:anywhere;
  border-bottom:2px solid transparent; transition:border-color .2s;
}
.say:hover{ border-bottom-color:var(--ember) }

/* ── footer ────────────────────────────────────────────────────────────── */
footer{ border-top:1px solid var(--line); padding:44px 0 52px; color:var(--muted); font-size:13px }
.foot{ display:flex; justify-content:space-between; gap:28px 48px; flex-wrap:wrap; align-items:flex-start }
.foot .lead{ max-width:280px }
.foot .lead .mk{ margin-bottom:12px; font-size:16px }
.foot .lead p{ line-height:1.58 }
.foot .cols{ display:flex; gap:12px 28px; flex-wrap:wrap; font-family:var(--mono); font-size:12px; letter-spacing:.04em }
.foot .cols a{ color:var(--muted); transition:color .18s }
.foot .cols a:hover{ color:var(--cyan) }
.foot-base{ margin-top:36px; padding-top:20px; border-top:1px solid var(--line); font-family:var(--mono); font-size:11.5px; font-variant-numeric:tabular-nums }
</style>
</Fragment>

<Fragment slot="nav">
<div class="bar">
  <div class="wrap">
    <a class="mk" href="/" aria-label="NeuroTrocity home"><i aria-hidden="true"></i><b>Neuro<span class="t">Trocity</span></b></a>
    <span class="grow"></span>
    <nav class="nav" aria-label="Primary">
      <a href={nav.back.href}>{nav.back.label}</a>
      {nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="navcta" href={nav.cta.href}>{nav.cta.label}</a>
  </div>
</div>
</Fragment>

<!-- hero -->
<div class="hero" id="s-hero" data-hero data-soma="Hero">
  <div class="wrap">
    <div class="copy" data-quiet>
      <p class="mono kick">{hero.kicker}</p>
      <h1>{hero.headline.lead}<em>{hero.headline.em}</em></h1>
      <p class="lede">{hero.lede.a}<strong>{hero.lede.strong}</strong>{hero.lede.b}</p>
      <div class="cta">
        <a class="btn p" href={hero.primary.href}>{hero.primary.label} <span class="arw" aria-hidden="true">→</span></a>
        {hero.ghost && <a class="btn g" href={hero.ghost.href}>{hero.ghost.label}</a>}
      </div>
    </div>
  </div>
</div>

<!-- the apps -->
<section class="sec" id="apps" data-soma="The apps">
  <div class="wrap">
    <div data-quiet>
      <p class="mono eyebrow">{apps.eyebrow}</p>
      <h2>{apps.heading}</h2>
      <p class="sub">{apps.sub}</p>
    </div>
    <div class="apps">
      <a class="app is-lead" href={lead.path} style={`--c:var(--${lead.accent})`} data-quiet>
        <span class="mono sl">/{lead.slug}</span>
        <h3>{lead.name}</h3>
        <p>{lead.description}</p>
        <span class="row">
          <span class="mt">{lead.platforms}</span>
          <span class="go">{apps.open} <span class="arw" aria-hidden="true">→</span></span>
        </span>
      </a>
      <div class="rest">
        {rest.map((a) => (
          <a class="app" href={a.path} style={`--c:var(--${a.accent})`} data-quiet>
            <span class="mono sl">/{a.slug}</span>
            <h3>{a.name}</h3>
            <p>{a.description}</p>
            <span class="row">
              <span class="mt">{a.platforms}</span>
              <span class="go">{apps.open} <span class="arw" aria-hidden="true">→</span></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- how we build -->
<section class="sec" id="rules" data-soma="How we build">
  <div class="wrap">
    <div data-quiet>
      <p class="mono eyebrow">{rules.eyebrow}</p>
      <h2>{rules.heading}</h2>
      <p class="sub">{rules.sub}</p>
    </div>
    <ul class="rules">
      {RULES.map((r) => <li class="rule" data-quiet><b>{r.title}</b> {r.body}</li>)}
    </ul>
  </div>
</section>

<!-- contact -->
<section class="sec contact" id="contact" data-soma="Contact">
  <div class="wrap">
    <div class="copy" data-quiet>
      <p class="mono eyebrow">{contact.eyebrow}</p>
      <h2>{contact.heading}</h2>
      <p class="sub">{contact.sub}</p>
      <a class="say" href={`mailto:${contact.email}`}>{contact.email}</a>
    </div>
  </div>
</section>

<Fragment slot="footer">
<footer>
  <div class="wrap">
    <div class="foot">
      <div class="lead">
        <a class="mk" href="/" aria-label="NeuroTrocity home"><i aria-hidden="true"></i><b>Neuro<span class="t">Trocity</span></b></a>
        <p>{footer.tagline}</p>
      </div>
      <nav class="cols" aria-label="Footer">
        {footer.links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href={`mailto:${footer.email}`}>{footer.email}</a>
      </nav>
    </div>
    <div class="foot-base">{footer.legal}</div>
  </div>
</footer>
</Fragment>

</Base>
