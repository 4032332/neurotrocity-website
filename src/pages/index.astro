<script is:inline>
(function(){
var cx=window.__cx=NTCortex(document.getElementById('cortex'),
  {hubs:14,maxFibers:340,branchLen:0.72,spread:0.98,lineAlpha:0.72,nodeAlpha:1,fire:0.16,spin:0.075,radius:0.42,cx:0.71,cy:0.5,fit:true,bloom:1.25,dust:130});

var bar=document.getElementById('bar');
addEventListener('scroll',function(){bar.style.borderBottomColor=scrollY>10?'var(--line)':'transparent'},{passive:true});

if(window.gsap){
  gsap.registerPlugin(ScrollTrigger);
  var reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* hero entrance */
  var tl=gsap.timeline({defaults:{ease:'power3.out'}});
  tl.from('#cortex',{opacity:0,duration:1.3},0)
    .from('.hero h1',{y:30,opacity:0,duration:.95},0.15)
    .from('.hero .lede',{y:22,opacity:0,duration:.85},0.42)
    .from('.hero .cta .btn',{y:16,opacity:0,duration:.6,stagger:.09},0.62)
    .from('.stats .stat',{y:18,opacity:0,duration:.6,stagger:.1},0.8);
  /* entrance owns zoom only; the scroll scrub owns dist/yaw/pitch.
     Sharing a property between two tweens made them fight for it. */
  if(!reduce && cx) tl.from(cx.view,{zoom:0.66,duration:2.2,ease:'power2.out'},0);

  /* Fail-safe. gsap.from() writes opacity:0 inline immediately, but rAF is
     throttled in a background tab — so a page opened in one (cmd-click, session
     restore) would sit with its copy invisible until focused. Snap the entrance
     to its end state if it hasn't actually run. A no-op for normal visitors,
     whose timeline has already completed by the time this fires. */
  function settleEntrance(){ if(tl.progress()<1) tl.progress(1); }
  if(document.hidden) settleEntrance();
  setTimeout(settleEntrance,2600);
  document.addEventListener('visibilitychange',function(){
    if(!document.hidden) ScrollTrigger.refresh();
  });


  /* scroll progress bar */
  gsap.to('#progbar',{scaleX:1,ease:'none',
    scrollTrigger:{trigger:document.body,start:'top top',end:'bottom bottom',scrub:0.3}});

  if(!reduce && cx){
    /* scroll flies you through the cortex and turns it */
    gsap.to(cx.view,{yaw:2.4,pitch:0.34,dist:1.5,ease:'none',
      scrollTrigger:{trigger:document.body,start:'top top',end:'bottom bottom',scrub:0.8}});
  }

  /* masked line reveal on section headings */
  gsap.utils.toArray('.reveal-h').forEach(function(el){
    gsap.fromTo(el,{clipPath:'inset(0 100% 0 0)',y:14},
      {clipPath:'inset(0 0% 0 0)',y:0,duration:1.0,ease:'power3.out',
       scrollTrigger:{trigger:el,start:'top 86%',once:true}});
  });
  /* section rules draw in */
  gsap.utils.toArray('.rule i').forEach(function(el){
    gsap.from(el,{scaleX:0,duration:.9,ease:'power2.out',
      scrollTrigger:{trigger:el,start:'top 92%',once:true}});
  });
  /* venture rows slide + stagger */
  gsap.from('.vrow',{x:-26,opacity:0,duration:.7,stagger:.11,ease:'power3.out',
    scrollTrigger:{trigger:'.man',start:'top 85%',once:true}});
  gsap.from('.runin div',{y:20,opacity:0,duration:.65,stagger:.1,ease:'power3.out',
    scrollTrigger:{trigger:'.runin',start:'top 84%',once:true}});
  gsap.from('.signal .em',{y:18,opacity:0,duration:.8,ease:'power3.out',
    scrollTrigger:{trigger:'.signal',start:'top 68%',once:true}});
  gsap.from('.contact .say',{y:18,opacity:0,duration:.8,ease:'power3.out',
    scrollTrigger:{trigger:'.contact',start:'top 82%',once:true}});

}
})();
</script>
