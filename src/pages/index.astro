---
import Base from '../layouts/Base.astro';
import VentureRow from '../components/VentureRow.astro';
import { PRODUCTS, RULES } from '../content/facts';
import { HOME } from '../content/copy';

const { meta, nav, hero, build, proof, rules, contact, footer } = HOME;
---
<Base title={meta.title} description={meta.description} accent="volt" field spine>

<Fragment slot="head">
<link rel="canonical" href="https://neurotrocity.com/" />
<style is:global>
/* ── frame ─────────────────────────────────────────────────────────────── */
a{ text-decoration:none }
.wrap{ max-width:var(--maxw); margin:0 auto; padding-inline:var(--pad) }
@media (min-width:1001px){ .wrap{ padding-left:calc(var(--gutter) + 16px) } }
.mono{ font-family:var(--mono); font-size:11px; letter-spacing:.16em; text-transform:uppercase; font-variant-numeric:tabular-nums }
strong{ color:var(--ink); font-weight:700 }

/* ── nav bar (Base renders the <header>; this styles it) ───────────────── */
body > header:has(.bar){
  position:sticky; top:0; z-index:10;
  background:color-mix(in srgb, var(--ground) 62%, transparent);
  backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  border-bottom:1px solid transparent;
}
@supports (animation-timeline: scroll()){
  /* Border fades in over the first 40px of scroll — no JS needed. */
  body > header:has(.bar){ animation:bar-on linear both; animation-timeline:scroll(root); animation-range:0 40px }
  @keyframes bar-on{ from{ border-bottom-color:transparent } to{ border-bottom-color:var(--line) } }
}
.bar .wrap{ display:flex; align-items:center; gap:18px; height:66px }
.mk{ display:inline-flex; align-items:center; gap:9px; font-weight:800; font-size:18px; letter-spacing:-.03em; color:var(--ink) }
.mk i{ width:9px; height:9px; border-radius:50%; background:var(--volt); box-shadow:0 0 12px var(--volt); display:block; flex:none }
.mk .t{ color:var(--volt) }
.grow{ flex:1 }
.nav{ display:flex; gap:22px; font-size:14px; color:var(--muted) }
.nav a{ transition:color .18s }
.nav a:hover{ color:var(--ink) }
@media (max-width:820px){ .nav{ display:none } }
.navcta{
  font-size:13.5px; font-weight:800; padding:9px 16px; border-radius:999px; color:var(--ink);
  border:1px solid color-mix(in srgb, var(--volt) 45%, transparent);
  background:color-mix(in srgb, var(--volt) 12%, transparent);
  transition:background .18s, border-color .18s;
}
.navcta:hover{ background:color-mix(in srgb, var(--volt) 26%, transparent); border-color:var(--volt) }

/* ── hero — the one full-volume moment ─────────────────────────────────── */
.hero{ min-height:min(88vh,760px); display:flex; align-items:center; padding-block:70px }
.hero .copy{ width:fit-content; max-width:100% }
.hero .kick{ color:var(--cyan); margin-bottom:20px }
.hero h1{ font-weight:800; font-size:var(--step-3); line-height:.99; letter-spacing:-.036em; max-width:15ch; text-wrap:balance }
.hero h1 em{ font-style:normal; color:var(--volt) }
.hero .lede{ margin-top:24px; max-width:47ch; color:var(--muted); font-size:clamp(15.5px,1.5vw,17.5px); line-height:1.64 }
.cta{ margin-top:32px; display:flex; gap:11px; flex-wrap:wrap }
.btn{
  display:inline-flex; align-items:center; gap:9px; font-size:14.5px; font-weight:800;
  padding:13px 21px; border-radius:6px; border:1px solid transparent; font-family:var(--body);
  transition:transform .18s, background .18s, border-color .18s, color .18s;
}
.btn .arw{ transition:transform .25s }
.btn:hover .arw{ transform:translateX(4px) }
.btn.p{ background:var(--volt); color:#fff }
.btn.p:hover{ background:color-mix(in srgb, var(--volt) 88%, white); transform:translateY(-2px) }
.btn.g{ border-color:var(--line-2); color:var(--ink) }
.btn.g:hover{ border-color:var(--cyan); color:var(--cyan); transform:translateY(-2px) }

/* ── sections — disciplined after the hero ─────────────────────────────── */
section.sec{ padding-block:clamp(64px,8vw,104px); position:relative }
section.sec + section.sec{ border-top:1px solid var(--line) }
.eyebrow{ color:var(--muted); margin-bottom:16px }
h2{ font-weight:800; font-size:var(--step-2); line-height:1.03; letter-spacing:-.034em; max-width:21ch; text-wrap:balance }
.sub{ margin-top:16px; color:var(--muted); font-size:16.5px; line-height:1.65; max-width:56ch }

/* ── #build: three services as a ruled grid ────────────────────────────── */
.svc{
  margin-top:44px; display:grid; gap:1px; background:var(--line);
  border:1px solid var(--line); border-radius:4px; overflow:hidden;
  grid-template-columns:repeat(3,1fr);
}
@media (max-width:900px){ .svc{ grid-template-columns:1fr } }
.svc > div{ background:var(--ground); padding:26px 24px 30px; transition:background .18s }
.svc > div:hover{ background:var(--ground-2) }
.svc h3{ font-weight:700; font-size:21px; letter-spacing:-.024em; margin-top:12px; color:var(--c) }
.svc h3 a{ color:inherit; border-bottom:1px solid transparent; transition:border-color .18s }
.svc h3 a:hover{ border-bottom-color:currentColor }
.svc p{ margin-top:10px; color:var(--muted); font-size:14.5px; line-height:1.6 }
.svc .n{ color:var(--muted) }

/* ── #proof: ventures as evidence, then the stance ─────────────────────── */
.man{ margin-top:40px }
.stance{
  margin-top:52px; padding:clamp(26px,4vw,44px); border:1px solid var(--line-2); border-radius:4px;
  background:
    linear-gradient(150deg,
      color-mix(in srgb, var(--volt) 10%, transparent),
      color-mix(in srgb, var(--cyan) 3%, transparent) 55%, transparent);
}
.stance p{ font-family:var(--display); font-weight:700; font-size:clamp(19px,2.5vw,29px); line-height:1.22; letter-spacing:-.028em; max-width:26ch; text-wrap:balance }
.stance p em{ font-style:normal; color:var(--cyan) }
.stance .note{ margin-top:18px; font-family:var(--body); font-weight:400; font-size:15px; line-height:1.62; color:var(--muted); max-width:56ch; letter-spacing:0; text-wrap:pretty }

/* ── #rules: four ruled lines ──────────────────────────────────────────── */
.rules{ margin-top:40px; border-top:1px solid var(--line); list-style:none; padding:0 }
.rule{ padding:21px 0; border-bottom:1px solid var(--line); font-size:15.5px; line-height:1.64; color:var(--muted); max-width:76ch }
.rule b{ color:var(--ink); font-weight:800 }

/* ── #contact ──────────────────────────────────────────────────────────── */
.contact{ text-align:center }
.contact .copy{ max-width:56ch; margin-inline:auto }
.contact h2, .contact .sub{ margin-inline:auto }
.say{
  display:inline-block; margin-top:28px; font-family:var(--display); font-size:clamp(21px,3.3vw,33px);
  font-weight:800; letter-spacing:-.03em; color:var(--volt);
  border-bottom:2px solid transparent; transition:border-color .2s;
}
.say:hover{ border-bottom-color:var(--volt) }

/* ── footer ────────────────────────────────────────────────────────────── */
footer{ border-top:1px solid var(--line); padding:44px 0 52px; color:var(--muted); font-size:13px }
.foot{ display:flex; justify-content:space-between; gap:28px 48px; flex-wrap:wrap; align-items:flex-start }
.foot .lead{ max-width:280px }
.foot .lead .mk{ margin-bottom:12px; font-size:16px }
.foot .lead p{ line-height:1.58 }
.foot .cols{ display:flex; gap:12px 28px; flex-wrap:wrap; font-family:var(--mono); font-size:12px; letter-spacing:.04em }
.foot .cols a{ color:var(--muted); transition:color .18s }
.foot .cols a:hover{ color:var(--cyan) }
.foot-base{ margin-top:36px; padding-top:20px; border-top:1px solid var(--line); font-family:var(--mono); font-size:11.5px; font-variant-numeric:tabular-nums }
</style>
</Fragment>

<Fragment slot="nav">
<div class="bar">
  <div class="wrap">
    <a class="mk" href="/" aria-label="NeuroTrocity home"><i aria-hidden="true"></i><b>Neuro<span class="t">Trocity</span></b></a>
    <span class="grow"></span>
    <nav class="nav" aria-label="Primary">
      {nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="navcta" href={nav.cta.href}>{nav.cta.label}</a>
  </div>
</div>
</Fragment>

<!-- hero -->
<div class="hero" id="s-hero" data-hero data-soma="Hero">
  <div class="wrap">
    <div class="copy" data-quiet>
    <p class="mono kick">{hero.kicker}</p>
    <h1>{hero.headline.lead}<em>{hero.headline.em}</em>{hero.headline.tail}</h1>
    <p class="lede">{hero.lede.a}<strong>{hero.lede.strong}</strong>{hero.lede.b}</p>
    <div class="cta">
      <a class="btn p" href={hero.primary.href}>{hero.primary.label} <span class="arw" aria-hidden="true">→</span></a>
      <a class="btn g" href={hero.ghost.href}>{hero.ghost.label}</a>
    </div>
    </div>
  </div>
</div>

<!-- what we build -->
<section class="sec" id="build" data-soma="What we build">
  <div class="wrap">
    <div data-quiet>
      <p class="mono eyebrow">{build.eyebrow}</p>
      <h2>{build.heading}</h2>
      <p class="sub">{build.sub.a}<strong>{build.sub.strong}</strong>{build.sub.b}</p>
    </div>
    <div class="svc">
      {build.services.map((s) => (
        <div style={`--c:var(--${s.accent})`}>
          <p class="mono n">{s.n}</p>
          <h3>{s.href ? <a href={s.href}>{s.title}</a> : s.title}</h3>
          <p>{s.blurb}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- proof -->
<section class="sec" id="proof" data-soma="Proof">
  <div class="wrap">
    <div data-quiet>
      <p class="mono eyebrow">{proof.eyebrow}</p>
      <h2>{proof.heading}</h2>
      <p class="sub">{proof.sub.a}<strong>{proof.sub.strong}</strong>{proof.sub.b}</p>
    </div>
    <div class="man">
      {PRODUCTS.map((p) => <VentureRow product={p} />)}
    </div>
    <div class="stance">
      <div data-quiet>
        <p>{proof.stance.lead}<em>{proof.stance.em}</em></p>
        <p class="note">{proof.stance.note}</p>
      </div>
    </div>
  </div>
</section>

<!-- how we work -->
<section class="sec" id="rules" data-soma="How we work">
  <div class="wrap">
    <div data-quiet>
      <p class="mono eyebrow">{rules.eyebrow}</p>
      <h2>{rules.heading}</h2>
    </div>
    <ul class="rules">
      {RULES.map((r) => <li class="rule" data-quiet><b>{r.title}</b> {r.body}</li>)}
    </ul>
  </div>
</section>

<!-- contact -->
<section class="sec contact" id="contact" data-soma="Contact">
  <div class="wrap">
    <div class="copy" data-quiet>
      <p class="mono eyebrow">{contact.eyebrow}</p>
      <h2>{contact.heading}</h2>
      <p class="sub">{contact.sub}</p>
      <a class="say" href={`mailto:${contact.email}`}>{contact.email}</a>
    </div>
  </div>
</section>

<Fragment slot="footer">
<footer>
  <div class="wrap">
    <div class="foot">
      <div class="lead">
        <a class="mk" href="/" aria-label="NeuroTrocity home"><i aria-hidden="true"></i><b>Neuro<span class="t">Trocity</span></b></a>
        <p>{footer.tagline}</p>
      </div>
      <nav class="cols" aria-label="Footer">
        {footer.ventures.map((v) => <a href={v.href}>/{v.label}</a>)}
        <a href={`mailto:${footer.email}`}>{footer.email}</a>
      </nav>
    </div>
    <div class="foot-base">{footer.legal}</div>
  </div>
</footer>
</Fragment>

</Base>
