---
import Base from '../layouts/Base.astro';
---
<Base
  title="NeuroTrocity — focused, honest software"
  description="NeuroTrocity is what happens when a brain fires every idea at once. The few that survive get built properly, and become ventures."
  accent="volt"
>
<Fragment slot="head">
<link rel="stylesheet" href="/assets/css/base.css">
<style>
:root{--bg:#08080D;--well:#05050a;--panel:#101018;--line:#20202E;--line2:#2b2b3d;
--ink:#F3F3F8;--muted:#8C8CA6;--volt:#7C6BFF;--cyan:#38E1D6;
--dose:#6C97F5;--dis:#FFB627;--rw:#0EA968;
--sans:"Manrope",-apple-system,system-ui,sans-serif;--mono:"Plex",ui-monospace,Menlo,monospace;--maxw:1120px}
*{box-sizing:border-box}
html{background:var(--bg);scroll-behavior:smooth}
body{line-height:normal;font-size:16px;margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}h1,h2,h3,p{margin:0}
::selection{background:var(--volt);color:#fff}
.nova{display:block;flex:none}
.nova-spin{transform-origin:100px 100px;animation:nspin 48s linear infinite}
.nova-ring{transform-origin:100px 100px;animation:nbreathe 3.6s ease-in-out infinite}
.nova-node{animation:ntwinkle 2.8s ease-in-out infinite}
.nova-spark{animation:ntwinkle 1.9s ease-in-out infinite}
.nova-node:nth-of-type(2){animation-delay:.35s}.nova-node:nth-of-type(3){animation-delay:.7s}
.nova-node:nth-of-type(4){animation-delay:1.05s}.nova-node:nth-of-type(5){animation-delay:1.4s}
.nova-node:nth-of-type(6){animation-delay:1.75s}.nova-node:nth-of-type(7){animation-delay:2.1s}
.nova-node:nth-of-type(8){animation-delay:2.45s}
@keyframes nspin{to{transform:rotate(360deg)}}
@keyframes nbreathe{0%,100%{transform:scale(1);opacity:.85}50%{transform:scale(1.14);opacity:1}}
@keyframes ntwinkle{0%,100%{opacity:.55;transform:scale(.9)}50%{opacity:1;transform:scale(1.12)}}
.mk{display:inline-flex;align-items:center;gap:10px;font-weight:800;font-size:19px;letter-spacing:-.03em}
.mk .t{color:var(--volt)}.mk .wm{white-space:nowrap}
@media(prefers-reduced-motion:reduce){.nova-spin,.nova-ring,.nova-node,.nova-spark{animation:none!important}}

.wrap{max-width:var(--maxw);margin:0 auto;padding:0 40px}
@media(max-width:760px){.wrap{padding:0 22px}}
/* scroll progress — visible proof the scroll pipeline is live */
.prog{position:fixed;top:0;left:0;right:0;height:2px;z-index:60;background:transparent}
.prog i{display:block;height:100%;width:100%;transform:scaleX(0);transform-origin:0 50%;
  background:linear-gradient(90deg,var(--volt),var(--cyan))}
.bar{position:sticky;top:0;z-index:50;backdrop-filter:blur(12px);
  background:color-mix(in srgb,var(--bg) 76%,transparent);border-bottom:1px solid transparent}
.bar .wrap{display:flex;align-items:center;gap:16px;height:70px}
.spacer{flex:1}
.nav{display:flex;gap:22px;font-size:14px;color:var(--muted)}.nav a:hover{color:var(--ink)}
.navcta{font-size:13.5px;font-weight:800;padding:9px 17px;border-radius:999px;
  border:1px solid rgba(124,107,255,.42);background:rgba(124,107,255,.11);transition:.2s}
.navcta:hover{background:rgba(124,107,255,.24);border-color:var(--volt)}
@media(max-width:820px){.nav{display:none}}@media(max-width:520px){.navcta{display:none}}
.hero{position:relative;display:grid;grid-template-columns:1fr 1fr;min-height:min(80vh,650px);overflow:hidden}
@media(max-width:880px){.hero{grid-template-columns:1fr;min-height:0}}
/* canvas spans the whole hero and is feathered out before it reaches the type,
   so there is no panel edge and no tonal step between the halves */
.hero canvas{position:absolute;inset:0;width:100%;height:100%;z-index:0}
.hero .feather{position:absolute;inset:0;z-index:1;pointer-events:none;
  background:
    linear-gradient(90deg,var(--bg) 0%,var(--bg) 24%,rgba(8,8,13,.80) 37%,rgba(8,8,13,.30) 52%,rgba(8,8,13,0) 66%),
    linear-gradient(180deg,rgba(8,8,13,.55) 0%,rgba(8,8,13,0) 22%,rgba(8,8,13,0) 74%,var(--bg) 100%)}
@media(max-width:880px){
  .hero .feather{background:
    linear-gradient(180deg,var(--bg) 0%,var(--bg) 30%,rgba(8,8,13,.72) 42%,rgba(8,8,13,0) 62%,rgba(8,8,13,0) 84%,var(--bg) 100%)}
}
.hero .lft{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:center;
  padding:78px 46px 76px max(40px,calc((100vw - var(--maxw))/2 + 40px))}
@media(max-width:880px){.hero .lft{padding:54px 22px 46px}}
h1{font-size:clamp(30px,3.9vw,50px);font-weight:800;line-height:1.05;letter-spacing:-.043em;max-width:17ch;text-wrap:balance}
h1 em{font-style:normal;color:var(--cyan)}
.lede{margin-top:22px;color:var(--muted);font-size:16.5px;line-height:1.62;max-width:44ch}
.cta{margin-top:32px;display:flex;gap:11px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:8px;font-size:14.5px;font-weight:800;padding:13px 20px;border-radius:7px;transition:.18s}
.btn.p{background:var(--volt);color:#fff}.btn.p:hover{background:#8b7bff;transform:translateY(-2px)}
.btn.g{border:1px solid var(--line2)}.btn.g:hover{border-color:var(--cyan);color:var(--cyan);transform:translateY(-2px)}
.btn .arw{transition:transform .25s}.btn:hover .arw{transform:translateX(4px)}
.hero .rgt{position:relative;z-index:2;min-height:360px;pointer-events:none}
@media(max-width:880px){.hero .rgt{min-height:330px}}
.stats{border-bottom:1px solid var(--line);position:relative;z-index:2}
.stats .wrap{display:flex;gap:52px;flex-wrap:wrap;padding-top:30px;padding-bottom:30px}
.stat .n{font-weight:800;font-size:27px;letter-spacing:-.03em;line-height:1}
.stat .n b{color:var(--cyan);font-weight:800}
.stat .l{margin-top:7px;font-family:var(--mono);font-size:10.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted)}
section{padding:74px 0}
.rule{display:flex;align-items:center;gap:14px;margin-bottom:18px}
.rule span{font-family:var(--mono);font-size:11px;color:var(--muted);letter-spacing:.17em;text-transform:uppercase;white-space:nowrap}
.rule i{flex:1;height:1px;background:var(--line);transform-origin:0 50%}
h2{font-size:clamp(25px,3.4vw,37px);font-weight:800;letter-spacing:-.033em;line-height:1.08;max-width:22ch;text-wrap:balance}
.sub{margin-top:15px;color:var(--muted);font-size:16px;line-height:1.62;max-width:54ch}
.man{margin-top:34px}
.vrow{display:grid;grid-template-columns:minmax(120px,auto) 1fr auto auto;gap:24px;align-items:baseline;
  padding:20px 0;border-bottom:1px solid var(--line);transition:background .18s}
.vrow:first-child{border-top:1px solid var(--line)}
.vrow:hover{background:#0c0c15}
.vrow .sl{font-family:var(--mono);font-size:13px;color:var(--c)}
.vrow .ds{color:var(--muted);font-size:15px;line-height:1.5}
.vrow .mt{font-family:var(--mono);font-size:10.5px;color:var(--muted);letter-spacing:.08em;white-space:nowrap}
.vrow .go{font-family:var(--mono);font-size:15px;color:var(--c);opacity:0;transition:.18s}
.vrow:hover .go{opacity:1;transform:translateX(3px)}
@media(max-width:820px){.vrow{grid-template-columns:1fr auto;gap:6px 16px}
 .vrow .sl{grid-column:1}.vrow .go{grid-column:2;grid-row:1;opacity:.5}
 .vrow .ds,.vrow .mt{grid-column:1/-1}}
.runin{margin-top:32px;border-top:1px solid var(--line)}
.runin div{padding:19px 0;border-bottom:1px solid var(--line);font-size:15.5px;line-height:1.62;color:var(--muted);max-width:78ch}
.runin b{color:var(--ink);font-weight:800}
.signal{border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  background:radial-gradient(78% 150% at 50% 0%,color-mix(in srgb,var(--cyan) 7%,transparent),transparent 72%)}
.signal .wrap{text-align:center;padding:80px 40px}
.signal h2{margin:0 auto;max-width:26ch}
.signal .em{display:inline-block;margin-top:24px;font-size:clamp(20px,3.2vw,30px);font-weight:800;letter-spacing:-.03em;color:var(--cyan)}
.contact{text-align:center;padding:96px 0 88px}
.contact h2{margin:0 auto}.contact .sub{margin:15px auto 0}
.contact .say{display:inline-block;margin-top:28px;font-size:clamp(21px,3.3vw,31px);font-weight:800;
  letter-spacing:-.03em;color:var(--volt);border-bottom:2px solid transparent;transition:border-color .2s}
.contact .say:hover{border-color:var(--volt)}
footer{border-top:1px solid var(--line);padding:56px 0 50px}
.foot{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap}
.foot .lead{max-width:270px}.foot .lead .mk{margin-bottom:13px}
.foot .lead p{color:var(--muted);font-size:13.5px;line-height:1.58}
.foot .cols{display:flex;gap:52px;flex-wrap:wrap}
.foot h4{font-family:var(--mono);font-size:10.5px;letter-spacing:.15em;text-transform:uppercase;margin-bottom:14px}
.foot .cols a{display:block;color:var(--muted);font-size:14px;margin-bottom:10px}
.foot .cols a:hover{color:var(--cyan)}
.foot-base{margin-top:44px;padding-top:22px;border-top:1px solid var(--line);display:flex;
  justify-content:space-between;gap:14px;flex-wrap:wrap;font-family:var(--mono);font-size:11.5px;color:var(--muted)}
</style>
</Fragment>

